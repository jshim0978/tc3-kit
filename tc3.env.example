# tc3-kit 설정 — 복사해서 tc3.env 로 저장 (bin/tc3 가 자동 로드)
#   cp tc3.env.example tc3.env && vi tc3.env
# 환경변수로 직접 넘겨도 됩니다: TC3_BACKEND=mock bin/tc3 all

# 백엔드: furiosa (RNGD VM, 본선) | vllm (L40S VM, 예비) | llamacpp (로컬 Docker 실추론) | mock (로컬 흐름만)
TC3_BACKEND=furiosa

# 추론 서버 주소/포트 (serve 가 띄우는 서버, verify/soak 가 호출하는 주소)
TC3_PORT=8000
TC3_API_URL=http://127.0.0.1:8000

# 서빙 모델 이름 (/v1/models 의 id, 요청의 "model")
TC3_MODEL_NAME=Llama-3.1-8B-Instruct

# 원본 가중치 (safetensors) — 파라미터 수 산출용 (meta-llama/Llama-3.1-8B-Instruct)
TC3_MODEL_DIR=/models/Llama-3.1-8B-Instruct
TC3_HF_REPO_MODEL=meta-llama/Llama-3.1-8B-Instruct
# 판정 기준: 파라미터 수 하한 (8B급 = 8e9). fixture(로컬)일 때는 자동 완화
TC3_MIN_PARAMS=8000000000

# [furiosa] RNGD 용 사전 컴파일 artifact
TC3_ARTIFACT_DIR=/models/furiosa-ai/Llama-3.1-8B-Instruct
TC3_HF_REPO_ARTIFACT=furiosa-ai/Llama-3.1-8B-Instruct
TC3_DEVICES=npu:0:*
# furiosa-llm 이 설치된 venv (비어 있으면 PATH 의 furiosa-llm 사용)
TC3_FURIOSA_VENV=

# [vllm] 도커 이미지 태그 — 리허설에서 검증한 태그로 고정
TC3_VLLM_IMAGE=vllm/vllm-openai:latest
TC3_VLLM_MAX_MODEL_LEN=8192

# 연속 요청 횟수 / 타임아웃
TC3_SOAK_N=100
TC3_SOAK_TIMEOUT=60
# 서버 준비 대기 상한(초) — 8B 모델 적재 + (furiosa) 초기화
TC3_READY_TIMEOUT=900

# HuggingFace 토큰 (gated 모델 다운로드용; fetch-model 에서만 사용)
HF_TOKEN=

# [로컬 테스트] 1 이면 model-size 단계에 합성 safetensors fixture 를 생성해 사용 (SIMULATED 표기)
TC3_FIXTURE=0

# 증빙 저장 루트 (기본: <kit>/evidence)
# TC3_EVIDENCE_DIR=
