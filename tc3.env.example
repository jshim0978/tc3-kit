# tc3-kit 설정 — 복사해서 tc3.env 로 저장 (bin/tc3 가 자동 로드)
#   cp tc3.env.example tc3.env && vi tc3.env
# 환경변수로 직접 넘겨도 됩니다: TC3_BACKEND=mock bin/tc3 all

# 백엔드: furiosa (RNGD VM, 본선) | vllm (L40S VM, 예비) | llamacpp (로컬 Docker 실추론) | mock (로컬 흐름만)
TC3_BACKEND=furiosa

# 추론 서버 주소/포트 (serve 가 띄우는 서버, verify/soak 가 호출하는 주소)
TC3_PORT=8000
# API 주소는 기본으로 http://127.0.0.1:${TC3_PORT} (포트와 어긋나지 않도록 보통은 지정하지 않음)
# TC3_API_URL=http://127.0.0.1:8000

# 서빙 모델 이름 (/v1/models 의 id, 요청의 "model")
TC3_MODEL_NAME=Llama-3.1-8B-Instruct

# 원본 가중치 (safetensors) — 파라미터 수 산출용 (meta-llama/Llama-3.1-8B-Instruct)
TC3_MODEL_DIR=/models/Llama-3.1-8B-Instruct
TC3_HF_REPO_MODEL=meta-llama/Llama-3.1-8B-Instruct
# 판정 기준: 파라미터 수 하한 (8B급 = 8e9). fixture(로컬)일 때는 자동 완화
TC3_MIN_PARAMS=8000000000

# [furiosa] RNGD 용 사전 컴파일 artifact
TC3_ARTIFACT_DIR=/models/furiosa-ai/Llama-3.1-8B-Instruct
TC3_HF_REPO_ARTIFACT=furiosa-ai/Llama-3.1-8B-Instruct
# furiosa-llm --devices: npu:0 = NPU 0 전체 (2025.1~2026.4 문서 표기). npu:0:* 는 2025.1 이하 구표기
TC3_DEVICES=npu:0
# furiosa-llm venv — install 이 만들고 모든 단계가 사용 (비우면 ~/furiosa-venv, none = PATH 의 furiosa-llm)
TC3_FURIOSA_VENV=
# ── SDK 버전 고정 (깨끗한 VM 에 당일 install 하므로 반드시 고정: 리허설에서 검증한 조합만 설치) ──
#   A) BF16 원본 정밀도 [기본]: 드라이버 2026.3.1 + furiosa-smi 2026.1.1-3 + furiosa-llm 2026.3.0
#                              + artifact furiosa-ai/Llama-3.1-8B-Instruct @ v2026.3
#   B) FP8: 드라이버 2026.4.0 + furiosa-smi 2026.4.0-3 + furiosa-llm 2026.4.0
#           + artifact furiosa-ai/Meta-Llama-3.1-8B-Instruct-FP8-dynamic @ v2026.4  (2026.4 는 FXB 필요 — BF16 저장소엔 2026.4 정식 태그 없음)
#   ※ 2026.5 가 곧 나올 예정(베타 공개됨) — 고정하지 않으면 당일 검증 안 된 버전이 설치될 수 있음
TC3_FURIOSA_DRIVER_PIN=2026.3.1
TC3_FURIOSA_SMI_PIN=2026.1.1-3
# fetch-model 전 필요한 디스크 여유(GB) — 원본 가중치 ~16 GB + artifact
TC3_FETCH_MIN_FREE_GB=40
# artifact HF 태그 (비우면 설치된 furiosa-llm 버전에 맞는 태그 자동 선택: 2026.3.x → v2026.3)
TC3_HF_ARTIFACT_REVISION=v2026.3
# install 시 furiosa-llm 고정 버전 (드라이버 릴리스와 같아야 함, 예: 2026.3.0)
TC3_FURIOSA_LLM_PIN=2026.3.0
# furiosa-llm serve 추가 인자 (예: --chat-template /path/t.jinja)
TC3_FURIOSA_SERVE_ARGS=

# [vllm] 도커 이미지 태그 — 리허설에서 검증한 태그로 고정
TC3_VLLM_IMAGE=vllm/vllm-openai:latest
TC3_VLLM_MAX_MODEL_LEN=8192

# 연속 요청 횟수 / 타임아웃
TC3_SOAK_N=100
TC3_SOAK_TIMEOUT=60
# 서버 준비 대기 상한(초) — 8B 모델 적재 + (furiosa) 초기화
TC3_READY_TIMEOUT=900
# stop: 서버가 내려갈 때까지 대기(초) / SIGTERM 후 SIGKILL 까지 유예(초)
TC3_STOP_TIMEOUT=60
TC3_KILL_GRACE=20
# 증빙 시각대 (VM 기본 TZ 가 UTC 여도 KST 로 기록)
TC3_TZ=Asia/Seoul

# HuggingFace 토큰 (gated 모델 다운로드용; fetch-model 에서만 사용)
HF_TOKEN=

# [로컬 테스트] 1 이면 model-size 단계에 합성 safetensors fixture 를 생성해 사용 (SIMULATED 표기)
TC3_FIXTURE=0

# 증빙 저장 루트 (기본: <kit>/evidence)
# TC3_EVIDENCE_DIR=
