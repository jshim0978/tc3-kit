#!/usr/bin/env bash
# tc3 — TC3(초거대AI 모델 검증 수) 공인인증시험 수행 CLI
#
#   bin/tc3 <command> [--backend furiosa|vllm|llamacpp|mock] [--env FILE] [--run DIR]
#
# 명령 (절차서 단계 번호와 대응):
#   install       패키지/드라이버/이미지 설치·확인 (idempotent)
#   hf-login      HF 로그인 (토큰 숨김 입력) + 원본 가중치 저장소 접근 확인 — gated 저장소용, fetch-model 전에
#   fetch-model   모델 가중치·artifact 다운로드
#   hf-logout     저장된 HF 토큰 삭제 (시험 후)
#   preflight     시험 전 점검 (가속기·서버 실행파일·가중치·포트·파이썬 패키지) — 증빙에 기록하지 않음
#   platform      [1~3] 플랫폼 증빙: openstack CLI 가 있으면 hypervisor/flavor/server 조회, 없으면 MANUAL
#   env           [4]   가속기 PCI/드라이버/실행환경 확인
#   model-size    [5]   모델 파라미터 수 산출 (safetensors)
#   serve         [6]   추론 서버 기동 + 준비 대기 + 적재 후 가속기 상태
#   verify        [7~9] /v1/models, 한국어·영어 고정 프롬프트 추론
#   soak          [10]  연속 N회 요청 (성공률·p50/p95)
#   stop          [11]  서버 정지·원복
#   report        증빙 디렉터리 → report.md / summary.json
#   all           env → model-size → serve → verify → soak → stop → report  (platform 은 별도)
#   status        현재 run 의 단계별 결과
set -uo pipefail

TC3_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"   # 심볼릭 링크로 실행해도 키트 위치를 찾음
export TC3_HOME
# shellcheck source=../lib/common.sh
source "$TC3_HOME/lib/common.sh"

# 맨 위 주석 블록(2번째 줄부터 첫 비주석 줄 전까지)을 도움말로 출력
usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$TC3_HOME/bin/tc3"; exit "${1:-0}"; }

# ---------- 인자 ----------
CMD="${1:-}"; [[ -z "$CMD" || "$CMD" == "-h" || "$CMD" == "--help" ]] && usage 0
shift
ENV_FILE="$TC3_HOME/tc3.env"
while (( $# )); do
  case "$1" in
    --backend|--env|--run) [[ $# -ge 2 && -n "$2" ]] || die "$1 다음에 값이 필요합니다" ;;&
    --backend) TC3_BACKEND="$2"; shift 2 ;;
    --env)     ENV_FILE="$2"; shift 2 ;;
    --run)     TC3_RUN_DIR="$2"; shift 2 ;;
    -h|--help) usage 0 ;;
    *) die "알 수 없는 옵션: $1" ;;
  esac
done

# ---------- 설정 로드 (파일 < 환경변수 우선) ----------
if [[ -f "$ENV_FILE" ]]; then
  # Windows 에서 편집한 파일(CRLF·BOM)·마지막 줄 개행 없음·따옴표 값도 안전하게 읽는다
  first=1
  while IFS= read -r line || [[ -n "$line" ]]; do
    (( first )) && { line="${line#$'\xef\xbb\xbf'}"; first=0; }
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*(#|$) || "$line" != *=* ]] && continue
    k="${line%%=*}"; v="${line#*=}"
    k="${k//[[:space:]]/}"
    [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { warn "$(basename "$ENV_FILE"): 무시한 줄: $line"; continue; }
    v="${v%%#*}"; v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
    if [[ "$v" =~ ^\"(.*)\"$ || "$v" =~ ^\'(.*)\'$ ]]; then v="${BASH_REMATCH[1]}"; fi
    [[ "$v" == "~" || "$v" == "~/"* ]] && v="$HOME${v#\~}"
    [[ -z "${!k:-}" ]] && export "$k=$v"
  done < "$ENV_FILE"
fi
: "${TC3_BACKEND:=furiosa}"
: "${TC3_PORT:=8000}"
: "${TC3_API_URL:=http://127.0.0.1:${TC3_PORT}}"
: "${TC3_MODEL_NAME:=Llama-3.1-8B-Instruct}"
: "${TC3_MODEL_DIR:=/models/Llama-3.1-8B-Instruct}"
: "${TC3_HF_REPO_MODEL:=meta-llama/Llama-3.1-8B-Instruct}"
: "${TC3_MIN_PARAMS:=8000000000}"
: "${TC3_ARTIFACT_DIR:=/models/furiosa-ai/Llama-3.1-8B-Instruct}"
: "${TC3_HF_REPO_ARTIFACT:=furiosa-ai/Llama-3.1-8B-Instruct}"
: "${TC3_DEVICES:=npu:0}"
: "${TC3_VLLM_IMAGE:=vllm/vllm-openai:latest}"
: "${TC3_SOAK_N:=100}"
: "${TC3_SOAK_TIMEOUT:=60}"
: "${TC3_READY_TIMEOUT:=900}"
: "${TC3_FIXTURE:=0}"
TC3_API_URL="${TC3_API_URL%/}"
export TC3_BACKEND TC3_PORT TC3_API_URL TC3_MODEL_NAME TC3_MODEL_DIR TC3_MIN_PARAMS TC3_ARTIFACT_DIR TC3_DEVICES TC3_VLLM_IMAGE TC3_SOAK_N TC3_SOAK_TIMEOUT TC3_READY_TIMEOUT TC3_FIXTURE
# 인터넷이 없는 VM: TC3_PROXY(예: master3 의 tools/tc3-proxy.py)로 외부 다운로드(apt·pip/uv·HF·curl)를 경유.
#   외부에서 받는 명령(install·fetch-model·hf-login·preflight)에서만 켠다 — serve 이후 단계에 넣으면
#   furiosa-llm(Ray)의 프로세스 간 gRPC 가 http_proxy 를 따라 프록시로 샐 수 있다.
use_proxy() {
  [[ -n "${TC3_PROXY:-}" ]] || return 0
  export http_proxy="$TC3_PROXY" https_proxy="$TC3_PROXY" HTTP_PROXY="$TC3_PROXY" HTTPS_PROXY="$TC3_PROXY"
  export HF_HUB_DISABLE_XET=1   # HF 의 Xet 전송 대신 일반 HTTPS (프록시 경유가 확실한 경로)
}
# 로컬 API 호출이 프록시로 새지 않도록 (VM 에 http_proxy 가 설정된 경우 대비)
export no_proxy="127.0.0.1,localhost${no_proxy:+,$no_proxy}" NO_PROXY="127.0.0.1,localhost${NO_PROXY:+,$NO_PROXY}"
# 파이썬 출력이 tee 파이프에서 버퍼링되지 않게 (soak 진행이 화면에 실시간으로 보이도록)
export PYTHONUNBUFFERED=1
# 증빙 시각을 KST 로 (VM 기본 TZ 가 UTC 여도 화면 캡처 시각과 일치)
export TZ="${TC3_TZ:-${TZ:-Asia/Seoul}}"
# 서버 포트와 API 주소가 어긋나면 경고 (serve 는 TC3_PORT 로 띄우고 verify/soak 은 TC3_API_URL 로 호출)
if [[ "$TC3_API_URL" =~ ^https?://(127\.0\.0\.1|localhost):([0-9]+)$ && "${BASH_REMATCH[2]}" != "$TC3_PORT" ]]; then
  warn "TC3_API_URL($TC3_API_URL) 의 포트가 TC3_PORT($TC3_PORT) 와 다릅니다 — tc3.env 확인"
fi

BE="$TC3_HOME/lib/backend_${TC3_BACKEND}.sh"
[[ -f "$BE" ]] || die "지원하지 않는 백엔드: $TC3_BACKEND (furiosa|vllm|llamacpp|mock)"
# 기본값: tc3 가 서버 프로세스를 직접 띄우고 내린다 (llamacpp 백엔드만 외부 서버 → 덮어씀)
be_external_server() { return 1; }
be_activate() { :; }
# shellcheck disable=SC1090
source "$BE"
be_activate   # 예: furiosa venv — 모든 단계가 같은 python/furiosa-llm 을 쓰도록 한 번만 활성화
SIM="$(be_simulated)"
KIT_REV="$(git -C "$TC3_HOME" rev-parse --short HEAD 2>/dev/null || echo '-')"

# 단계 시작 시 한 줄: 어느 증빙 run 에 기록되는지 화면(캡처)에 남긴다
banner() { log "run: evidence/$(basename "$TC3_RUN_DIR")  backend: $TC3_BACKEND  kit: $KIT_REV"; }

PY="$TC3_HOME/scripts"
KO_PROMPT='대한민국의 수도와 그 도시의 대표 명소 두 곳을 세 문장으로 소개해 주세요.'
EN_PROMPT='Explain in two sentences what an NPU is and how it differs from a GPU.'

# ---------- 단계 구현 ----------
# 사전 준비(install / fetch-model): 시험 당일 깨끗한 VM 에서 수행 → 전체 출력을 증빙(prep_<이름>.log)에도 남긴다
_prep() { # _prep <이름> <함수>
  local name="$1" fn="$2" lg rc
  lg="$TC3_RUN_DIR/prep_${name}.log"
  { echo "# TC3 prep — $name"; echo "# time: $(now_iso)  host: $(hostname)  user: $(id -un)  backend: $TC3_BACKEND  kit: $KIT_REV"; echo "# ----"; } >> "$lg"
  "$fn" 2>&1 | tee -a "$lg"; rc=${PIPESTATUS[0]}
  { echo "# exit: $rc"; echo; } >> "$lg"
  return "$rc"
}
cmd_install()     { use_proxy; evidence_resume; banner; log "install — $(be_describe)"; _prep install be_install; }
cmd_fetch_model() { use_proxy; evidence_resume; banner; log "fetch-model — $(be_describe)"; _prep fetch_model be_fetch_model; }

# HF 로그인 (gated 원본 가중치용): 토큰을 숨김 입력으로 받아 huggingface_hub.login() 에 stdin 으로 넘긴다.
#  - `hf auth login` 은 버전에 따라 브라우저 로그인 메뉴(화살표 선택)가 먼저 떠서 원격 터미널에서 실수 여지가 있음
#  - 토큰은 화면·프로세스 목록(argv)·로그 어디에도 남지 않고, 표준 위치(~/.cache/huggingface/token)에 저장된다
_hf_whoami() { python3 -c 'from huggingface_hub import whoami; print(whoami()["name"])' 2>/dev/null; }
cmd_hf_login() {
  use_proxy; evidence_resume; banner
  python3 -c 'import huggingface_hub' 2>/dev/null || { fail "huggingface_hub 가 없습니다 — bin/tc3 install 먼저"; return 1; }
  local who tok=""
  if who="$(_hf_whoami)" && [[ -n "$who" ]]; then
    ok "이미 HF 로그인됨: $who"
  else
    read -rsp "HF 토큰 입력 (huggingface.co/settings/tokens — 입력 내용은 화면에 표시되지 않음): " tok; echo
    [[ -n "$tok" ]] || { fail "토큰이 비어 있습니다"; return 1; }
    if ! printf '%s' "$tok" | python3 -c 'import sys
from huggingface_hub import login
login(token=sys.stdin.read().strip(), add_to_git_credential=False)' >/dev/null 2>&1; then
      unset tok; fail "HF 로그인 실패 — 토큰이 올바른지 확인 (read 권한 이상)"; return 1
    fi
    unset tok
    who="$(_hf_whoami)" || true
    [[ -n "$who" ]] || { fail "로그인 후 계정 확인 실패 (네트워크/프록시 확인)"; return 1; }
    ok "HF 로그인: $who"
  fi
  hf_access "$TC3_HF_REPO_MODEL" || { fail "계정 $who 로 $TC3_HF_REPO_MODEL 에 접근할 수 없음 — huggingface.co 에서 Llama 3.1 라이선스 동의 확인"; return 1; }
  { echo "# TC3 prep — hf_login  time: $(now_iso)  account: $who  repo: $TC3_HF_REPO_MODEL  access: OK  (토큰 값은 기록하지 않음)"; } >> "$TC3_RUN_DIR/prep_hf_login.log"
  ok "HF 접근 확인: $who → $TC3_HF_REPO_MODEL"
}
cmd_hf_logout() {
  python3 -c 'import huggingface_hub' 2>/dev/null || { warn "huggingface_hub 없음 — 저장된 토큰도 없음"; return 0; }
  python3 -c 'from huggingface_hub import logout; logout()' >/dev/null 2>&1 || true
  if [[ -n "$(_hf_whoami)" ]]; then fail "로그아웃 후에도 토큰이 남아 있음 (HF_TOKEN 환경변수 확인)"; return 1; fi
  ok "HF 로그아웃 — 저장된 토큰 삭제"
}

cmd_platform() {
  evidence_resume; banner
  local rc=0
  if have openstack && [[ -n "${OS_AUTH_URL:-}" ]]; then
    capture 1 hypervisors "DUT1 하이퍼바이저 목록"      -- "openstack hypervisor list" || rc=1
    capture 2 flavor      "가속기 패스스루 flavor"       -- "openstack flavor show '${TC3_FLAVOR:-m1.large.rngd}' -c name -c vcpus -c ram -c disk -c properties" || rc=1
    capture 3 server      "시험용 VM 상태/배치 노드"      -- "openstack server show '${TC3_SERVER:-etri-llm-test}' -c name -c status -c flavor -c image -c addresses -c OS-EXT-SRV-ATTR:hypervisor_hostname" || rc=1
    # 조회 실패(권한 부족 등)는 선택 절차이므로 MANUAL(Horizon 캡처로 대체)로 기록 — 종합 판정을 FAIL 로 만들지 않음
    if (( rc == 0 )); then record 1 platform PASS "openstack CLI"; else record 1 platform MANUAL "openstack CLI 조회 실패 — Horizon 캡처로 대체"; rc=0; fi
  else
    {
      echo "# TC3 step 01~03 — 플랫폼 증빙 (MANUAL)"
      echo "# time: $(now_iso)"
      echo "openstack CLI/인증정보가 이 호스트에 없어 Horizon 화면 캡처로 대체한다:"
      echo "  [1] Admin > Compute > Hypervisors  : compute1/compute5/compute6 목록"
      echo "  [2] Admin > Compute > Flavors > ${TC3_FLAVOR:-m1.large.rngd} : Metadata 의 pci_passthrough:alias"
      echo "  [3] Project > Compute > Instances > ${TC3_SERVER:-etri-llm-test} : Status=Active, Host(hypervisor), IP"
    } > "$TC3_RUN_DIR/step01-03_platform_MANUAL.txt"
    record 1 platform MANUAL "Horizon 캡처로 대체 (step01-03_platform_MANUAL.txt 참고)"
  fi
  return $rc
}

cmd_env() {
  evidence_resume; banner
  if be_env_check 4; then
    if (( SIM )); then record 4 env SIMULATED "로컬 환경 — 가속기 없음"; else record 4 env PASS "가속기 인식·실행환경 확인"; fi
  else
    record 4 env FAIL "가속기/드라이버 확인 실패"; return 1
  fi
}

cmd_model_size() {
  evidence_resume; banner
  local dir="$TC3_MODEL_DIR" min="$TC3_MIN_PARAMS" simnote=""
  if [[ ! -d "$dir" || -z "$(ls "$dir"/*.safetensors 2>/dev/null)" ]]; then
    if [[ "$TC3_FIXTURE" == "1" ]]; then
      dir="$TC3_RUN_DIR/fixture-model"; min=1
      python3 "$PY/make_fixture_model.py" "$dir" >/dev/null
      simnote="fixture(합성 safetensors) 사용"
    else
      record 5 model_size FAIL "가중치 없음: $dir (fetch-model 먼저 실행하거나 TC3_FIXTURE=1)"; return 1
    fi
  fi
  local rc=0 out="$TC3_RUN_DIR/.model_params.out"
  capture 5 model_ls    "모델 가중치 디렉터리"        -- "ls -lh '$dir'" || rc=1
  # 이번 시도의 출력만 따로 받아 수치를 읽는다 (재수행 시 로그에 남은 이전 수치를 읽지 않도록)
  capture 5 model_params "파라미터 수 산출(safetensors)" -- "python3 '$PY/tc3_count_params.py' '$dir' | tee '$out'" || rc=1
  be_model_extra 5 || true
  local total
  total="$(grep -h 'total parameters' "$out" 2>/dev/null | tail -1 | sed -E 's/.*= *([0-9,]+).*/\1/' | tr -d ',')"
  rm -f "$out"
  if (( rc == 0 )) && [[ "$total" =~ ^[0-9]+$ ]] && (( total >= min )); then
    if [[ -n "$simnote" ]]; then record 5 model_size SIMULATED "$simnote: $total params"
    else record 5 model_size PASS "total parameters = $total (≥ $min)"; fi
  else
    record 5 model_size FAIL "total=${total:-?}, 기준=$min"; return 1
  fi
}

cmd_serve() {
  evidence_resume; banner
  # 서버는 로컬 artifact 만 쓴다 — VM 환경(/etc/environment 등)에 프록시가 있어도 서버에는 넘기지 않는다
  #   (furiosa-llm 의 Ray gRPC 는 노드 IP 로 통신하므로 no_proxy=127.0.0.1 만으로는 프록시로 샐 수 있음)
  unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY grpc_proxy GRPC_PROXY
  local pid="" rc=0
  if ! be_external_server; then
    # 이전에 tc3 가 띄운 서버가 살아 있으면(serve 재실행·중단 후 재시도) 정지하고 다시 띄운다
    if server_alive; then
      warn "이전에 기동한 서버(pid $(server_pid))가 실행 중 → 정지 후 다시 기동합니다"
      be_serve_stop
      wait_down "$TC3_API_URL/v1/models" "${TC3_STOP_TIMEOUT:-60}" || true
    fi
    # 다른 프로세스가 포트를 잡고 있으면 기동해도 실패하므로 바로 FAIL (대기 시간 낭비 방지)
    if port_in_use "$TC3_PORT"; then
      capture 6 serve_port "포트 ${TC3_PORT} 사용 프로세스" -- "$(port_owner_cmd "$TC3_PORT")" || true
      record 6 serve FAIL "포트 ${TC3_PORT} 이 다른 프로세스에 사용 중 — 해당 프로세스 정리 후 재실행"; return 1
    fi
  fi
  be_serve_start
  be_external_server || pid="$(server_pid)"
  log "준비 대기: $TC3_API_URL/v1/models (최대 ${TC3_READY_TIMEOUT}s)"
  wait_http "$TC3_API_URL/v1/models" "$TC3_READY_TIMEOUT" "$pid"; rc=$?
  if (( rc == 0 )); then
    capture 6 serve_log "서버 기동 로그 (마지막 40줄)" -- "tail -n 40 '$TC3_RUN_DIR/server.log'" || true
    be_accel_status 6
    local sid; sid="$(curl -sS -m 10 "$TC3_API_URL/v1/models" 2>/dev/null | json_get '.data[0].id' 2>/dev/null || true)"
    [[ "$sid" == "$TC3_MODEL_NAME" ]] || warn "서버 모델 id='$sid' ≠ TC3_MODEL_NAME='$TC3_MODEL_NAME' → 절차 7~10 이 실패합니다 (SDK 버전/--served-model-name 확인)"
    if (( SIM )); then record 6 serve SIMULATED "로컬 서버 준비됨"; else record 6 serve PASS "추론 서버 준비 완료"; fi
  else
    capture 6 serve_log "서버 기동 로그 (실패)" -- "tail -n 80 '$TC3_RUN_DIR/server.log'" || true
    if (( rc == 2 )); then
      record 6 serve FAIL "서버 프로세스가 준비 전에 종료됨 — server.log 확인"
    else
      record 6 serve FAIL "준비 시간 초과 (${TC3_READY_TIMEOUT}s) — server.log 확인, 정리: bin/tc3 stop"
    fi
    return 1
  fi
}

_write_req() { # _write_req <file> <prompt>
  python3 -c 'import json,sys; json.dump({"model":sys.argv[1],"temperature":0,"max_tokens":256,"messages":[{"role":"user","content":sys.argv[2]}]}, open(sys.argv[3],"w",encoding="utf-8"), ensure_ascii=False, indent=2)' "$TC3_MODEL_NAME" "$2" "$1"
}
_check_chat() { # _check_chat <response.json> → 0 if ok (요약 한 줄 출력)
  python3 - "$1" <<'PYEOF'
import json, sys
try:
    d = json.load(open(sys.argv[1], encoding="utf-8"))
    ch = (d.get("choices") or [{}])[0]
    c = ((ch.get("message") or {}).get("content") or "").strip()
except Exception as e:  # noqa: BLE001
    sys.exit(f"응답 파싱 실패: {type(e).__name__}: {e}")
if not c:
    sys.exit("빈 응답(content 없음)")
u = d.get("usage") or {}
print(f"content_len={len(c)} finish_reason={ch.get('finish_reason')} completion_tokens={u.get('completion_tokens')}")
PYEOF
}
_chat_step() { # _chat_step <step#> <slug> <title> <prompt>
  local step="$1" slug="$2" title="$3" prompt="$4"
  local p; p="$TC3_RUN_DIR/step$(printf '%02d' "$step")"
  local req="${p}_request.json" resp="${p}_response.json" lg="${p}_${slug}.log"
  _write_req "$req" "$prompt"
  rm -f "$resp"
  if ! capture "$step" "$slug" "$title" -- "cat '$req'; echo; curl -sS -m 180 '$TC3_API_URL/v1/chat/completions' -H 'Content-Type: application/json' -d @'$req' | tee '$resp' | python3 -m json.tool --no-ensure-ascii"; then
    # 연결 실패·JSON 아님 등: 결과를 반드시 status 에 남긴다 (누락되면 report 판정이 왜곡됨)
    local head; head="$(head -c 120 "$resp" 2>/dev/null | tr -d '\r\n')"
    record "$step" "$slug" FAIL "요청/응답 오류${head:+: $head}"; return 1
  fi
  local summary
  if summary="$(_check_chat "$resp" 2>&1)"; then echo "# check: $summary" >> "$lg"; record "$step" "$slug" PASS "$summary"
  else echo "# check: $summary" >> "$lg"; record "$step" "$slug" FAIL "응답 검증 실패: ${summary##*$'\n'}"; return 1; fi
}

cmd_verify() {
  evidence_resume; banner
  local rc=0 mj="$TC3_RUN_DIR/step07_models.json"
  rm -f "$mj"
  capture 7 models "모델 목록 API" -- "curl -sS -m 30 '$TC3_API_URL/v1/models' | tee '$mj' | python3 -m json.tool --no-ensure-ascii" || rc=1
  # 화면에 찍힌 바로 그 응답(step07_models.json)에서 id 를 읽는다
  local id; id="$(json_get '.data[0].id' < "$mj" 2>/dev/null || true)"
  if (( rc == 0 )) && [[ "$id" == "$TC3_MODEL_NAME" ]]; then record 7 models PASS "id=$id"; else record 7 models FAIL "id='$id' (기대: $TC3_MODEL_NAME)"; rc=1; fi
  _chat_step 8 chat_ko "한국어 고정 프롬프트 추론" "$KO_PROMPT" || rc=1
  _chat_step 9 chat_en "영어 고정 프롬프트 추론"   "$EN_PROMPT" || rc=1
  return $rc
}

cmd_soak() {
  evidence_resume; banner
  local csv="$TC3_RUN_DIR/soak_result.csv" sj="$TC3_RUN_DIR/soak_summary.json" lg="$TC3_RUN_DIR/step10_soak.log"
  rm -f "$sj"   # 이번 시도의 요약만 판정에 사용
  local rc=0
  capture 10 soak "연속 요청 ${TC3_SOAK_N}회" -- "python3 '$PY/tc3_soak.py' --url '$TC3_API_URL' --model '$TC3_MODEL_NAME' --n '$TC3_SOAK_N' --timeout '$TC3_SOAK_TIMEOUT' --out '$csv' --summary-json '$sj'" || rc=1
  local note=""
  [[ -f "$sj" ]] && note="$(python3 - "$sj" 2>/dev/null <<'PYEOF'
import json, sys
s = json.load(open(sys.argv[1], encoding="utf-8"))
print("success : %d/%d (%.1f%%), latency p50 : %.3f s, latency p95 : %.3f s" % (s["ok"], s["n"], s["success_pct"], s["p50"], s["p95"]))
PYEOF
)"
  if (( rc == 0 )) && [[ -n "$note" ]]; then
    record 10 soak PASS "$note"
  else
    [[ -z "$note" ]] && note="$(grep -v '^#' "$lg" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -1)"
    record 10 soak FAIL "${note:-soak 실행 실패 — step10_soak.log 확인}"; return 1
  fi
}

cmd_stop() {
  evidence_resume; banner
  be_serve_stop
  if be_external_server && curl -fsS -m 3 "$TC3_API_URL/v1/models" >/dev/null 2>&1; then
    capture 11 stop "서버 정지 (외부 서버 — 시뮬레이션)" -- "curl -sS -m 3 '$TC3_API_URL/v1/models' >/dev/null && echo 'external local server still running (stop it with docker compose stop llm)'" || true
    record 11 stop SIMULATED "외부 로컬 서버는 tc3 가 정지하지 않음"; return 0
  fi
  # 워커 종료·NPU 해제까지 시간이 걸릴 수 있어 "연결 거부" 가 될 때까지 기다린다
  if ! wait_down "$TC3_API_URL/v1/models" "${TC3_STOP_TIMEOUT:-60}"; then
    record 11 stop FAIL "서버가 ${TC3_STOP_TIMEOUT:-60}s 후에도 내려가지 않음 — $(port_owner_cmd "$TC3_PORT") 로 확인"; return 1
  fi
  capture 11 stop "서버 정지 확인" -- "curl -sS -m 3 '$TC3_API_URL/v1/models' || echo 'server stopped (connection refused)'" || true
  be_accel_status 11
  record 11 stop PASS "서버 정지·원복"
}

cmd_report() {
  evidence_resume; banner
  rm -f "$TC3_RUN_DIR/report.md" "$TC3_RUN_DIR/summary.json"   # 실패 시 이전 report 가 남아 최신처럼 보이지 않도록
  python3 "$PY/tc3_report.py" "$TC3_RUN_DIR" --backend "$TC3_BACKEND" --describe "$(be_describe)" --model "$TC3_MODEL_NAME" --kit-rev "$KIT_REV" \
    || { fail "report 생성 실패"; return 1; }
  log "report: $TC3_RUN_DIR/report.md"
  local overall; overall="$(json_get '.overall' < "$TC3_RUN_DIR/summary.json" 2>/dev/null)"
  [[ "$overall" == "PASS" || "$overall" == "SIMULATED" ]]
}

cmd_status() {
  evidence_resume
  python3 - "$TC3_RUN_DIR/status.tsv" <<'PYEOF'
import csv, sys, unicodedata
# 한글 등 전각 문자는 터미널에서 2칸 → 표시 폭 기준으로 정렬
wid = lambda s: sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)
rows = [r + [""] * (5 - len(r)) for r in csv.reader(open(sys.argv[1], encoding="utf-8"), delimiter="\t")]
w = [max(wid(r[i]) for r in rows) for i in range(5)]
for r in rows:
    print("  ".join(r[i] + " " * (w[i] - wid(r[i])) for i in range(5)).rstrip())
PYEOF
}

# 시험 전 점검: 증빙에는 기록하지 않고, 문제를 한눈에 보여준다. 치명 항목이 있으면 종료코드 1.
PF_BAD=0; PF_WARN=0
pf_ok()   { printf '  %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
pf_bad()  { printf '  %s✗%s %s\n' "$C_RED" "$C_RESET" "$*"; PF_BAD=$((PF_BAD + 1)); }
pf_warn() { printf '  %s!%s %s\n' "$C_YEL" "$C_RESET" "$*"; PF_WARN=$((PF_WARN + 1)); }
cmd_preflight() {
  use_proxy
  log "preflight — $(be_describe)"
  log "kit: $KIT_REV  host: $(hostname)  user: $(id -un)  time: $(now_iso)"
  echo "  설정: backend=$TC3_BACKEND model=$TC3_MODEL_NAME port=$TC3_PORT api=$TC3_API_URL soak_n=$TC3_SOAK_N ready_timeout=${TC3_READY_TIMEOUT}s fixture=$TC3_FIXTURE"
  local dirty; dirty="$(git -C "$TC3_HOME" status --porcelain --untracked-files=no 2>/dev/null | wc -l)"
  if [[ "$KIT_REV" == "-" ]]; then pf_warn "키트가 git 저장소가 아님 (커밋 확인 불가)"
  elif (( dirty > 0 )); then pf_warn "키트에 커밋되지 않은 수정 ${dirty}개 (git status 확인)"
  else pf_ok "키트 커밋 $KIT_REV (수정 없음)"; fi
  [[ -x "$TC3_HOME/bin/tc3" ]] && pf_ok "bin/tc3 실행 권한" || pf_bad "bin/tc3 실행 권한 없음 → chmod +x bin/tc3"
  [[ -f "$ENV_FILE" ]] && pf_ok "설정 파일: $ENV_FILE" || pf_warn "설정 파일 없음: $ENV_FILE (기본값 사용) → cp tc3.env.example tc3.env"
  have curl && pf_ok "curl" || pf_bad "curl 없음"
  if python3 -c 'import sys; sys.exit(sys.version_info < (3, 8))' 2>/dev/null; then pf_ok "python3 $(python3 -c 'import platform; print(platform.python_version())')"; else pf_bad "python3 >= 3.8 없음"; fi
  if python3 -c 'import requests, safetensors, numpy' 2>/dev/null; then pf_ok "python 패키지 requests·safetensors·numpy"; else pf_bad "python 패키지 누락 → bin/tc3 install"; fi
  have jq && pf_ok "jq" || pf_warn "jq 없음 (python 으로 대체 — 동작에는 문제 없음)"
  local root; root="$(evidence_root)"
  if mkdir -p "$root" 2>/dev/null && [[ -w "$root" ]]; then
    local free_kb; free_kb="$(df -Pk "$root" 2>/dev/null | awk 'NR == 2 { print $4 }')"
    if [[ -n "$free_kb" ]] && (( free_kb < 1048576 )); then pf_warn "증빙 디스크 여유 $((free_kb / 1024)) MB (< 1 GB)"; else pf_ok "증빙 디렉터리 쓰기 가능: $root"; fi
  else pf_bad "증빙 디렉터리 쓰기 불가: $root"; fi
  if [[ -f "$root/.current_run" ]]; then
    local base; base="$(basename "$(cat "$root/.current_run")")"
    if [[ "$base" == "$(date +%Y%m%d)-"* && "$base" == *"-$TC3_BACKEND" ]]; then pf_warn "오늘 run 이 이미 있음 → 이어서 기록됨: evidence/$base (새 run 을 원하면 rm evidence/.current_run)"
    else pf_ok "다음 단계는 새 run 으로 기록됨 (이전: $base)"; fi
  else pf_ok "다음 단계는 새 run 으로 기록됨"; fi
  if [[ "$TC3_FIXTURE" == "1" ]]; then pf_warn "TC3_FIXTURE=1 — 합성 fixture 로 파라미터 수 산출 (시험 당일은 0)"
  else
    local wc; if wc="$(check_weights "$TC3_MODEL_DIR" 2>&1)"; then pf_ok "원본 가중치 완전: $TC3_MODEL_DIR"
    else
      pf_bad "원본 가중치 문제: ${wc##*$'\n'} → bin/tc3 fetch-model"
      local hu; hu="$(_hf_whoami)"
      if [[ -n "$hu" ]]; then pf_ok "HF 로그인: $hu (fetch-model 가능)"; else pf_warn "HF 미로그인 — gated 저장소면 bin/tc3 hf-login 후 fetch-model"; fi
    fi
  fi
  if ! be_external_server; then
    if server_alive; then pf_warn "tc3 가 띄운 서버 실행 중 (pid $(server_pid)) — serve 시 자동 재기동, 정리: bin/tc3 stop"
    elif port_in_use "$TC3_PORT"; then pf_bad "포트 $TC3_PORT 을 다른 프로세스가 사용 중 → $(port_owner_cmd "$TC3_PORT")"
    else pf_ok "포트 $TC3_PORT 비어 있음"; fi
  fi
  if [[ -n "${TC3_PROXY:-}" ]]; then
    local hc; hc="$(curl -s -o /dev/null -m 15 -w '%{http_code}' https://huggingface.co 2>/dev/null)"
    if [[ "$hc" =~ ^(2|3) ]]; then pf_ok "TC3_PROXY=$TC3_PROXY 경유 외부 접속 정상 (huggingface.co → $hc)"
    elif check_weights "$TC3_MODEL_DIR" >/dev/null 2>&1 && [[ "$TC3_BACKEND" != furiosa || -n "$(ls -A "$TC3_ARTIFACT_DIR" 2>/dev/null)" ]]; then
      # 받을 것을 이미 다 받았으면 serve 이후 단계에는 인터넷이 필요 없다
      pf_warn "TC3_PROXY=$TC3_PROXY 경유 외부 접속 안 됨 (huggingface.co → ${hc:-연결 안 됨}) — 가중치·artifact 는 이미 있어 시험 단계에는 영향 없음"
    else pf_bad "TC3_PROXY=$TC3_PROXY 경유 외부 접속 실패 (huggingface.co → ${hc:-연결 안 됨}) — master3 의 tc3-proxy 실행 확인"; fi
  elif [[ -n "${http_proxy:-}${HTTP_PROXY:-}${https_proxy:-}${HTTPS_PROXY:-}" ]]; then
    pf_ok "프록시 설정 감지 — 127.0.0.1/localhost 는 우회(no_proxy)"
  fi
  pf_ok "시각대: $(date '+%Z %z')"
  declare -F be_preflight >/dev/null && be_preflight
  echo
  if (( PF_BAD > 0 )); then fail "preflight: 문제 ${PF_BAD}건, 주의 ${PF_WARN}건 — 해결 후 시험 진행"; return 1; fi
  ok "preflight: 문제 없음 (주의 ${PF_WARN}건)"
}

cmd_all() {
  evidence_init
  log "run dir: $TC3_RUN_DIR"
  log "backend: $(be_describe)"
  local failed=0
  cmd_env        || failed=1
  cmd_model_size || failed=1
  if cmd_serve; then
    cmd_verify || failed=1
    cmd_soak   || failed=1
  else failed=1; fi
  cmd_stop || failed=1
  cmd_report || failed=1
  echo; cmd_status
  (( failed )) && { fail "일부 단계 실패 — $TC3_RUN_DIR 확인"; return 1; }
  ok "모든 단계 완료 — $TC3_RUN_DIR"
}

case "$CMD" in
  install) cmd_install ;;            fetch-model) cmd_fetch_model ;;
  hf-login) cmd_hf_login ;;          hf-logout) cmd_hf_logout ;;
  preflight) cmd_preflight ;;        platform) cmd_platform ;;
  env) cmd_env ;;                    model-size) cmd_model_size ;;
  serve) cmd_serve ;;                verify) cmd_verify ;;
  soak) cmd_soak ;;                  stop) cmd_stop ;;
  report) cmd_report ;;              status) cmd_status ;;
  all) cmd_all ;;
  *) die "알 수 없는 명령: $CMD (bin/tc3 --help)" ;;
esac
