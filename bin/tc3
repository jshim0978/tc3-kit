#!/usr/bin/env bash
# tc3 — TC3(초거대AI 모델 검증 수) 공인인증시험 수행 CLI
#
#   bin/tc3 <command> [--backend furiosa|vllm|llamacpp|mock] [--env FILE] [--run DIR]
#
# 시험 당일 3단계 (./start.sh 1·2·3 과 같음):
#   preflight     ① 사전준비 확인 — 버전·가중치·artifact·포트·디스크·시계를 표 한 장으로 (evidence/<run>/prep_check.log·json)
#   live          ② 시험 스크립트 재생 — 왼쪽 run 실시간 출력, 오른쪽 NPU 상태 패널(1초) [tmux]. tmux 없으면 run --inline-monitor
#   run           ② 재생 (한 화면): preflight → env → model-size → serve → verify → soak → stop → report, NPU 모니터·그래프
#                    [--soak-n N] [--from <단계>] [--keep-going] [--inline-monitor] [--no-monitor]
#   result        ③ 결과 저장·확인 — RESULT.md 생성 후 출력  [--files 주요 로그 출력] [--zip 제출용 압축]
#
# 사전준비(리허설) 명령:
#   install       패키지/드라이버/이미지 설치·확인 (idempotent)
#   hf-login      HF 로그인 (토큰 숨김 입력) + 원본 가중치 저장소 접근 확인 — gated 저장소용, fetch-model 전에
#   fetch-model   모델 가중치·artifact 다운로드
#   hf-logout     저장된 HF 토큰 삭제 (시험 후)
#
# 개별 단계 (절차서 단계 번호와 대응):
#   platform      [1~3] 플랫폼 증빙: openstack CLI 가 있으면 hypervisor/flavor/server 조회, 없으면 MANUAL
#   env           [4]   가속기 PCI/드라이버/실행환경 확인
#   model-size    [5]   모델 파라미터 수 산출 (safetensors)
#   serve         [6]   추론 서버 기동 + 준비 대기 + 적재 후 가속기 상태
#   verify        [7~9] /v1/models, 한국어·영어 고정 프롬프트 추론
#   soak          [10]  연속 N회 요청 (성공률·p50/p95)
#   stop          [11]  서버 정지·원복
#   report        증빙 디렉터리 → report.md / summary.json
#   all           env → model-size → serve → verify → soak → stop → report  (platform 은 별도)
#   status        현재 run 의 단계별 결과
set -uo pipefail

TC3_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"   # 심볼릭 링크로 실행해도 키트 위치를 찾음
export TC3_HOME
# shellcheck source=../lib/common.sh
source "$TC3_HOME/lib/common.sh"

# 맨 위 주석 블록(2번째 줄부터 첫 비주석 줄 전까지)을 도움말로 출력
usage() { awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$TC3_HOME/bin/tc3"; exit "${1:-0}"; }

# ---------- 인자 ----------
CMD="${1:-}"; [[ -z "$CMD" || "$CMD" == "-h" || "$CMD" == "--help" ]] && usage 0
shift
ENV_FILE="$TC3_HOME/tc3.env"
RUN_FROM=""; RUN_KEEP=""; RUN_MON="on"; RESULT_FILES=""; RESULT_ZIP=""
while (( $# )); do
  case "$1" in
    --backend|--env|--run|--soak-n|--from) [[ $# -ge 2 && -n "$2" ]] || die "$1 다음에 값이 필요합니다" ;;&
    --backend) TC3_BACKEND="$2"; shift 2 ;;
    --env)     ENV_FILE="$2"; shift 2 ;;
    --run)     TC3_RUN_DIR="$2"; shift 2 ;;
    --soak-n)  [[ "$2" =~ ^[1-9][0-9]*$ ]] || die "--soak-n 은 1 이상의 정수"; TC3_SOAK_N="$2"; shift 2 ;;
    --from)    RUN_FROM="$2"; shift 2 ;;
    --keep-going)     RUN_KEEP=1; shift ;;
    --inline-monitor) RUN_MON=inline; shift ;;
    --no-monitor)     RUN_MON=off; shift ;;
    --files) RESULT_FILES=1; shift ;;
    --zip)   RESULT_ZIP=1; shift ;;
    -h|--help) usage 0 ;;
    *) die "알 수 없는 옵션: $1" ;;
  esac
done

# ---------- 설정 로드 (파일 < 환경변수 우선) ----------
if [[ -f "$ENV_FILE" ]]; then
  # Windows 에서 편집한 파일(CRLF·BOM)·마지막 줄 개행 없음·따옴표 값도 안전하게 읽는다
  first=1
  while IFS= read -r line || [[ -n "$line" ]]; do
    (( first )) && { line="${line#$'\xef\xbb\xbf'}"; first=0; }
    line="${line%$'\r'}"
    [[ "$line" =~ ^[[:space:]]*(#|$) || "$line" != *=* ]] && continue
    k="${line%%=*}"; v="${line#*=}"
    k="${k//[[:space:]]/}"
    [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { warn "$(basename "$ENV_FILE"): 무시한 줄: $line"; continue; }
    v="${v%%#*}"; v="${v#"${v%%[![:space:]]*}"}"; v="${v%"${v##*[![:space:]]}"}"
    if [[ "$v" =~ ^\"(.*)\"$ || "$v" =~ ^\'(.*)\'$ ]]; then v="${BASH_REMATCH[1]}"; fi
    [[ "$v" == "~" || "$v" == "~/"* ]] && v="$HOME${v#\~}"
    [[ -z "${!k:-}" ]] && export "$k=$v"
  done < "$ENV_FILE"
fi
: "${TC3_BACKEND:=furiosa}"
: "${TC3_PORT:=8000}"
: "${TC3_API_URL:=http://127.0.0.1:${TC3_PORT}}"
: "${TC3_MODEL_NAME:=Llama-3.1-8B-Instruct}"
: "${TC3_MODEL_DIR:=/models/Llama-3.1-8B-Instruct}"
: "${TC3_HF_REPO_MODEL:=meta-llama/Llama-3.1-8B-Instruct}"
: "${TC3_MIN_PARAMS:=8000000000}"
: "${TC3_ARTIFACT_DIR:=/models/furiosa-ai/Llama-3.1-8B-Instruct}"
: "${TC3_HF_REPO_ARTIFACT:=furiosa-ai/Llama-3.1-8B-Instruct}"
: "${TC3_DEVICES:=npu:0}"
: "${TC3_VLLM_IMAGE:=vllm/vllm-openai:latest}"
: "${TC3_SOAK_N:=100}"
: "${TC3_SOAK_TIMEOUT:=60}"
: "${TC3_READY_TIMEOUT:=900}"
: "${TC3_FIXTURE:=0}"
TC3_API_URL="${TC3_API_URL%/}"
export TC3_BACKEND TC3_PORT TC3_API_URL TC3_MODEL_NAME TC3_MODEL_DIR TC3_MIN_PARAMS TC3_ARTIFACT_DIR TC3_DEVICES TC3_VLLM_IMAGE TC3_SOAK_N TC3_SOAK_TIMEOUT TC3_READY_TIMEOUT TC3_FIXTURE
# 인터넷이 없는 VM: TC3_PROXY(예: master3 의 tools/tc3-proxy.py)로 외부 다운로드(apt·pip/uv·HF·curl)를 경유.
#   외부에서 받는 명령(install·fetch-model·hf-login·preflight)에서만 켠다 — serve 이후 단계에 넣으면
#   furiosa-llm(Ray)의 프로세스 간 gRPC 가 http_proxy 를 따라 프록시로 샐 수 있다.
use_proxy() {
  [[ -n "${TC3_PROXY:-}" ]] || return 0
  export http_proxy="$TC3_PROXY" https_proxy="$TC3_PROXY" HTTP_PROXY="$TC3_PROXY" HTTPS_PROXY="$TC3_PROXY"
  export HF_HUB_DISABLE_XET=1   # HF 의 Xet 전송 대신 일반 HTTPS (프록시 경유가 확실한 경로)
}
# 로컬 API 호출이 프록시로 새지 않도록 (VM 에 http_proxy 가 설정된 경우 대비)
export no_proxy="127.0.0.1,localhost${no_proxy:+,$no_proxy}" NO_PROXY="127.0.0.1,localhost${NO_PROXY:+,$NO_PROXY}"
# 파이썬 출력이 tee 파이프에서 버퍼링되지 않게 (soak 진행이 화면에 실시간으로 보이도록)
export PYTHONUNBUFFERED=1
# 증빙 시각을 KST 로 (VM 기본 TZ 가 UTC 여도 화면 캡처 시각과 일치)
export TZ="${TC3_TZ:-${TZ:-Asia/Seoul}}"
# 서버 포트와 API 주소가 어긋나면 경고 (serve 는 TC3_PORT 로 띄우고 verify/soak 은 TC3_API_URL 로 호출)
if [[ "$TC3_API_URL" =~ ^https?://(127\.0\.0\.1|localhost):([0-9]+)$ && "${BASH_REMATCH[2]}" != "$TC3_PORT" ]]; then
  warn "TC3_API_URL($TC3_API_URL) 의 포트가 TC3_PORT($TC3_PORT) 와 다릅니다 — tc3.env 확인"
fi

BE="$TC3_HOME/lib/backend_${TC3_BACKEND}.sh"
[[ -f "$BE" ]] || die "지원하지 않는 백엔드: $TC3_BACKEND (furiosa|vllm|llamacpp|mock)"
# 기본값: tc3 가 서버 프로세스를 직접 띄우고 내린다 (llamacpp 백엔드만 외부 서버 → 덮어씀)
be_external_server() { return 1; }
be_activate() { :; }
# NPU 모니터 소스(tc3_npu_monitor.py --backend)와 live 오른쪽 패널 명령 — 가속기가 없는 로컬 백엔드는 CPU 로 흉내(SIMULATED)
be_monitor_backend() { echo cpu; }
be_live_panel_cmd() { echo "python3 '$TC3_HOME/scripts/tc3_npu_monitor.py' --backend cpu --once"; }
# shellcheck disable=SC1090
source "$BE"
be_activate   # 예: furiosa venv — 모든 단계가 같은 python/furiosa-llm 을 쓰도록 한 번만 활성화
SIM="$(be_simulated)"
KIT_REV="$(git -C "$TC3_HOME" rev-parse --short HEAD 2>/dev/null || echo '-')"

# 단계 시작 시 한 줄: 어느 증빙 run 에 기록되는지 화면(캡처)에 남긴다
banner() { log "run: evidence/$(basename "$TC3_RUN_DIR")  backend: $TC3_BACKEND  kit: $KIT_REV"; }

PY="$TC3_HOME/scripts"
KO_PROMPT='대한민국의 수도와 그 도시의 대표 명소 두 곳을 세 문장으로 소개해 주세요.'
EN_PROMPT='Explain in two sentences what an NPU is and how it differs from a GPU.'

# ---------- 단계 구현 ----------
# 사전 준비(install / fetch-model): 시험 당일 깨끗한 VM 에서 수행 → 전체 출력을 증빙(prep_<이름>.log)에도 남긴다
_prep() { # _prep <이름> <함수>
  local name="$1" fn="$2" lg rc
  lg="$TC3_RUN_DIR/prep_${name}.log"
  { echo "# TC3 prep — $name"; echo "# time: $(now_iso)  host: $(hostname)  user: $(id -un)  backend: $TC3_BACKEND  kit: $KIT_REV"; echo "# ----"; } >> "$lg"
  "$fn" 2>&1 | tee -a "$lg"; rc=${PIPESTATUS[0]}
  { echo "# exit: $rc"; echo; } >> "$lg"
  return "$rc"
}
cmd_install()     { use_proxy; evidence_resume; banner; log "install — $(be_describe)"; _prep install be_install; }
cmd_fetch_model() { use_proxy; evidence_resume; banner; log "fetch-model — $(be_describe)"; _prep fetch_model be_fetch_model; }

# HF 로그인 (gated 원본 가중치용): 토큰을 숨김 입력으로 받아 huggingface_hub.login() 에 stdin 으로 넘긴다.
#  - `hf auth login` 은 버전에 따라 브라우저 로그인 메뉴(화살표 선택)가 먼저 떠서 원격 터미널에서 실수 여지가 있음
#  - 토큰은 화면·프로세스 목록(argv)·로그 어디에도 남지 않고, 표준 위치(~/.cache/huggingface/token)에 저장된다
_hf_whoami() { python3 -c 'from huggingface_hub import whoami; print(whoami()["name"])' 2>/dev/null; }
cmd_hf_login() {
  use_proxy; evidence_resume; banner
  python3 -c 'import huggingface_hub' 2>/dev/null || { fail "huggingface_hub 가 없습니다 — bin/tc3 install 먼저"; return 1; }
  local who tok=""
  if who="$(_hf_whoami)" && [[ -n "$who" ]]; then
    ok "이미 HF 로그인됨: $who"
  else
    read -rsp "HF 토큰 입력 (huggingface.co/settings/tokens — 입력 내용은 화면에 표시되지 않음): " tok; echo
    [[ -n "$tok" ]] || { fail "토큰이 비어 있습니다"; return 1; }
    if ! printf '%s' "$tok" | python3 -c 'import sys
from huggingface_hub import login
login(token=sys.stdin.read().strip(), add_to_git_credential=False)' >/dev/null 2>&1; then
      unset tok; fail "HF 로그인 실패 — 토큰이 올바른지 확인 (read 권한 이상)"; return 1
    fi
    unset tok
    who="$(_hf_whoami)" || true
    [[ -n "$who" ]] || { fail "로그인 후 계정 확인 실패 (네트워크/프록시 확인)"; return 1; }
    ok "HF 로그인: $who"
  fi
  hf_access "$TC3_HF_REPO_MODEL" || { fail "계정 $who 로 $TC3_HF_REPO_MODEL 에 접근할 수 없음 — huggingface.co 에서 Llama 3.1 라이선스 동의 확인"; return 1; }
  { echo "# TC3 prep — hf_login  time: $(now_iso)  account: $who  repo: $TC3_HF_REPO_MODEL  access: OK  (토큰 값은 기록하지 않음)"; } >> "$TC3_RUN_DIR/prep_hf_login.log"
  ok "HF 접근 확인: $who → $TC3_HF_REPO_MODEL"
}
cmd_hf_logout() {
  python3 -c 'import huggingface_hub' 2>/dev/null || { warn "huggingface_hub 없음 — 저장된 토큰도 없음"; return 0; }
  python3 -c 'from huggingface_hub import logout; logout()' >/dev/null 2>&1 || true
  if [[ -n "$(_hf_whoami)" ]]; then fail "로그아웃 후에도 토큰이 남아 있음 (HF_TOKEN 환경변수 확인)"; return 1; fi
  ok "HF 로그아웃 — 저장된 토큰 삭제"
}

cmd_platform() {
  evidence_resume; banner
  local rc=0
  if have openstack && [[ -n "${OS_AUTH_URL:-}" ]]; then
    capture 1 hypervisors "DUT1 하이퍼바이저 목록"      -- "openstack hypervisor list" || rc=1
    capture 2 flavor      "가속기 패스스루 flavor"       -- "openstack flavor show '${TC3_FLAVOR:-m1.large.rngd}' -c name -c vcpus -c ram -c disk -c properties" || rc=1
    capture 3 server      "시험용 VM 상태/배치 노드"      -- "openstack server show '${TC3_SERVER:-etri-llm-test}' -c name -c status -c flavor -c image -c addresses -c OS-EXT-SRV-ATTR:hypervisor_hostname" || rc=1
    # 조회 실패(권한 부족 등)는 선택 절차이므로 MANUAL(Horizon 캡처로 대체)로 기록 — 종합 판정을 FAIL 로 만들지 않음
    if (( rc == 0 )); then record 1 platform PASS "openstack CLI"; else record 1 platform MANUAL "openstack CLI 조회 실패 — Horizon 캡처로 대체"; rc=0; fi
  else
    {
      echo "# TC3 step 01~03 — 플랫폼 증빙 (MANUAL)"
      echo "# time: $(now_iso)"
      echo "openstack CLI/인증정보가 이 호스트에 없어 Horizon 화면 캡처로 대체한다:"
      echo "  [1] Admin > Compute > Hypervisors  : compute1/compute5/compute6 목록"
      echo "  [2] Admin > Compute > Flavors > ${TC3_FLAVOR:-m1.large.rngd} : Metadata 의 pci_passthrough:alias"
      echo "  [3] Project > Compute > Instances > ${TC3_SERVER:-etri-llm-test} : Status=Active, Host(hypervisor), IP"
    } > "$TC3_RUN_DIR/step01-03_platform_MANUAL.txt"
    record 1 platform MANUAL "Horizon 캡처로 대체 (step01-03_platform_MANUAL.txt 참고)"
  fi
  return $rc
}

cmd_env() {
  evidence_resume; banner
  if be_env_check 4; then
    if (( SIM )); then record 4 env SIMULATED "로컬 환경 — 가속기 없음"; else record 4 env PASS "가속기 인식·실행환경 확인"; fi
  else
    record 4 env FAIL "가속기/드라이버 확인 실패"; return 1
  fi
}

cmd_model_size() {
  evidence_resume; banner
  local dir="$TC3_MODEL_DIR" min="$TC3_MIN_PARAMS" simnote=""
  if [[ ! -d "$dir" || -z "$(ls "$dir"/*.safetensors 2>/dev/null)" ]]; then
    if [[ "$TC3_FIXTURE" == "1" ]]; then
      dir="$TC3_RUN_DIR/fixture-model"; min=1
      python3 "$PY/make_fixture_model.py" "$dir" >/dev/null
      simnote="fixture(합성 safetensors) 사용"
    else
      record 5 model_size FAIL "가중치 없음: $dir (fetch-model 먼저 실행하거나 TC3_FIXTURE=1)"; return 1
    fi
  fi
  local rc=0 out="$TC3_RUN_DIR/.model_params.out"
  capture 5 model_ls    "모델 가중치 디렉터리"        -- "ls -lh '$dir'" || rc=1
  # 이번 시도의 출력만 따로 받아 수치를 읽는다 (재수행 시 로그에 남은 이전 수치를 읽지 않도록)
  capture 5 model_params "파라미터 수 산출(safetensors)" -- "python3 '$PY/tc3_count_params.py' '$dir' | tee '$out'" || rc=1
  be_model_extra 5 || true
  local total
  total="$(grep -h 'total parameters' "$out" 2>/dev/null | tail -1 | sed -E 's/.*= *([0-9,]+).*/\1/' | tr -d ',')"
  rm -f "$out"
  if (( rc == 0 )) && [[ "$total" =~ ^[0-9]+$ ]] && (( total >= min )); then
    if [[ -n "$simnote" ]]; then record 5 model_size SIMULATED "$simnote: $total params"
    else record 5 model_size PASS "total parameters = $total (≥ $min)"; fi
  else
    record 5 model_size FAIL "total=${total:-?}, 기준=$min"; return 1
  fi
}

cmd_serve() {
  evidence_resume; banner
  # 서버는 로컬 artifact 만 쓴다 — VM 환경(/etc/environment 등)에 프록시가 있어도 서버에는 넘기지 않는다
  #   (furiosa-llm 의 Ray gRPC 는 노드 IP 로 통신하므로 no_proxy=127.0.0.1 만으로는 프록시로 샐 수 있음)
  unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY grpc_proxy GRPC_PROXY
  local pid="" rc=0
  if ! be_external_server; then
    # 이전에 tc3 가 띄운 서버가 살아 있으면(serve 재실행·중단 후 재시도) 정지하고 다시 띄운다
    if server_alive; then
      warn "이전에 기동한 서버(pid $(server_pid))가 실행 중 → 정지 후 다시 기동합니다"
      be_serve_stop
      wait_down "$TC3_API_URL/v1/models" "${TC3_STOP_TIMEOUT:-60}" || true
    fi
    # 다른 프로세스가 포트를 잡고 있으면 기동해도 실패하므로 바로 FAIL (대기 시간 낭비 방지)
    if port_in_use "$TC3_PORT"; then
      capture 6 serve_port "포트 ${TC3_PORT} 사용 프로세스" -- "$(port_owner_cmd "$TC3_PORT")" || true
      record 6 serve FAIL "포트 ${TC3_PORT} 이 다른 프로세스에 사용 중 — 해당 프로세스 정리 후 재실행"; return 1
    fi
  fi
  # NPU 초기화 구간(기동 ~ 준비 완료): NPU 모니터·live 패널의 furiosa-smi 조회를 멈춘다
  #   (10/20 etri-llm-test 에서 기동 중 "EBUSY: Device or resource busy" — 장치를 여는 순간 다른 조회와 겹치지 않도록)
  _npu_quiet start
  be_serve_start
  be_external_server || pid="$(server_pid)"
  log "준비 대기: $TC3_API_URL/v1/models (최대 ${TC3_READY_TIMEOUT}s)"
  wait_http "$TC3_API_URL/v1/models" "$TC3_READY_TIMEOUT" "$pid"; rc=$?
  _npu_quiet end
  if (( rc == 0 )); then
    capture 6 serve_log "서버 기동 로그 (마지막 40줄)" -- "tail -n 40 '$TC3_RUN_DIR/server.log'" || true
    be_accel_status 6
    local sid; sid="$(curl -sS -m 10 "$TC3_API_URL/v1/models" 2>/dev/null | json_get '.data[0].id' 2>/dev/null || true)"
    [[ "$sid" == "$TC3_MODEL_NAME" ]] || warn "서버 모델 id='$sid' ≠ TC3_MODEL_NAME='$TC3_MODEL_NAME' → 절차 7~10 이 실패합니다 (SDK 버전/--served-model-name 확인)"
    if (( SIM )); then record 6 serve SIMULATED "로컬 서버 준비됨"; else record 6 serve PASS "추론 서버 준비 완료"; fi
  else
    capture 6 serve_log "서버 기동 로그 (실패)" -- "tail -n 80 '$TC3_RUN_DIR/server.log'" || true
    if (( rc == 2 )); then
      record 6 serve FAIL "서버 프로세스가 준비 전에 종료됨 — server.log 확인"
    else
      record 6 serve FAIL "준비 시간 초과 (${TC3_READY_TIMEOUT}s) — server.log 확인, 정리: bin/tc3 stop"
    fi
    return 1
  fi
}

# _npu_quiet start|end : <run>/.npu_quiet 파일이 있는 동안 모니터·패널은 furiosa-smi 를 부르지 않는다 (구간은 npu_quiet.tsv 에 기록)
_npu_quiet() {
  [[ "${TC3_NPU_QUIET_INIT:-1}" == 1 ]] || return 0
  if [[ "$1" == start ]]; then : > "$TC3_RUN_DIR/.npu_quiet"; else rm -f "$TC3_RUN_DIR/.npu_quiet"; fi
  printf '%s\t%s\t%s\n' "$1" "$EPOCHREALTIME" "$(now_iso)" >> "$TC3_RUN_DIR/npu_quiet.tsv"
}

_write_req() { # _write_req <file> <prompt>
  python3 -c 'import json,sys; json.dump({"model":sys.argv[1],"temperature":0,"max_tokens":256,"messages":[{"role":"user","content":sys.argv[2]}]}, open(sys.argv[3],"w",encoding="utf-8"), ensure_ascii=False, indent=2)' "$TC3_MODEL_NAME" "$2" "$1"
}
_check_chat() { # _check_chat <response.json> → 0 if ok (요약 한 줄 출력)
  python3 - "$1" <<'PYEOF'
import json, sys
try:
    d = json.load(open(sys.argv[1], encoding="utf-8"))
    ch = (d.get("choices") or [{}])[0]
    c = ((ch.get("message") or {}).get("content") or "").strip()
except Exception as e:  # noqa: BLE001
    sys.exit(f"응답 파싱 실패: {type(e).__name__}: {e}")
if not c:
    sys.exit("빈 응답(content 없음)")
u = d.get("usage") or {}
print(f"content_len={len(c)} finish_reason={ch.get('finish_reason')} completion_tokens={u.get('completion_tokens')}")
PYEOF
}
_chat_step() { # _chat_step <step#> <slug> <title> <prompt>
  local step="$1" slug="$2" title="$3" prompt="$4"
  local p; p="$TC3_RUN_DIR/step$(printf '%02d' "$step")"
  local req="${p}_request.json" resp="${p}_response.json" lg="${p}_${slug}.log"
  _write_req "$req" "$prompt"
  rm -f "$resp"
  if ! capture "$step" "$slug" "$title" -- "cat '$req'; echo; curl -sS -m 180 '$TC3_API_URL/v1/chat/completions' -H 'Content-Type: application/json' -d @'$req' | tee '$resp' | python3 -m json.tool --no-ensure-ascii"; then
    # 연결 실패·JSON 아님 등: 결과를 반드시 status 에 남긴다 (누락되면 report 판정이 왜곡됨)
    local head; head="$(head -c 120 "$resp" 2>/dev/null | tr -d '\r\n')"
    record "$step" "$slug" FAIL "요청/응답 오류${head:+: $head}"; return 1
  fi
  local summary
  if summary="$(_check_chat "$resp" 2>&1)"; then echo "# check: $summary" >> "$lg"; record "$step" "$slug" PASS "$summary"
  else echo "# check: $summary" >> "$lg"; record "$step" "$slug" FAIL "응답 검증 실패: ${summary##*$'\n'}"; return 1; fi
}

cmd_verify() {
  evidence_resume; banner
  local rc=0 mj="$TC3_RUN_DIR/step07_models.json"
  rm -f "$mj"
  capture 7 models "모델 목록 API" -- "curl -sS -m 30 '$TC3_API_URL/v1/models' | tee '$mj' | python3 -m json.tool --no-ensure-ascii" || rc=1
  # 화면에 찍힌 바로 그 응답(step07_models.json)에서 id 를 읽는다
  local id; id="$(json_get '.data[0].id' < "$mj" 2>/dev/null || true)"
  if (( rc == 0 )) && [[ "$id" == "$TC3_MODEL_NAME" ]]; then record 7 models PASS "id=$id"; else record 7 models FAIL "id='$id' (기대: $TC3_MODEL_NAME)"; rc=1; fi
  _chat_step 8 chat_ko "한국어 고정 프롬프트 추론" "$KO_PROMPT" || rc=1
  _chat_step 9 chat_en "영어 고정 프롬프트 추론"   "$EN_PROMPT" || rc=1
  return $rc
}

cmd_soak() {
  evidence_resume; banner
  local csv="$TC3_RUN_DIR/soak_result.csv" sj="$TC3_RUN_DIR/soak_summary.json" lg="$TC3_RUN_DIR/step10_soak.log"
  rm -f "$sj"   # 이번 시도의 요약만 판정에 사용
  local rc=0
  capture 10 soak "연속 요청 ${TC3_SOAK_N}회" -- "python3 '$PY/tc3_soak.py' --url '$TC3_API_URL' --model '$TC3_MODEL_NAME' --n '$TC3_SOAK_N' --timeout '$TC3_SOAK_TIMEOUT' --out '$csv' --summary-json '$sj'" || rc=1
  local note=""
  [[ -f "$sj" ]] && note="$(python3 - "$sj" 2>/dev/null <<'PYEOF'
import json, sys
s = json.load(open(sys.argv[1], encoding="utf-8"))
print("success : %d/%d (%.1f%%), latency p50 : %.3f s, latency p95 : %.3f s" % (s["ok"], s["n"], s["success_pct"], s["p50"], s["p95"]))
PYEOF
)"
  if (( rc == 0 )) && [[ -n "$note" ]]; then
    record 10 soak PASS "$note"
  else
    [[ -z "$note" ]] && note="$(grep -v '^#' "$lg" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -1)"
    record 10 soak FAIL "${note:-soak 실행 실패 — step10_soak.log 확인}"; return 1
  fi
}

cmd_stop() {
  evidence_resume; banner
  be_serve_stop
  if be_external_server && curl -fsS -m 3 "$TC3_API_URL/v1/models" >/dev/null 2>&1; then
    capture 11 stop "서버 정지 (외부 서버 — 시뮬레이션)" -- "curl -sS -m 3 '$TC3_API_URL/v1/models' >/dev/null && echo 'external local server still running (stop it with docker compose stop llm)'" || true
    record 11 stop SIMULATED "외부 로컬 서버는 tc3 가 정지하지 않음"; return 0
  fi
  # 워커 종료·NPU 해제까지 시간이 걸릴 수 있어 "연결 거부" 가 될 때까지 기다린다
  if ! wait_down "$TC3_API_URL/v1/models" "${TC3_STOP_TIMEOUT:-60}"; then
    record 11 stop FAIL "서버가 ${TC3_STOP_TIMEOUT:-60}s 후에도 내려가지 않음 — $(port_owner_cmd "$TC3_PORT") 로 확인"; return 1
  fi
  capture 11 stop "서버 정지 확인" -- "curl -sS -m 3 '$TC3_API_URL/v1/models' || echo 'server stopped (connection refused)'" || true
  be_accel_status 11
  record 11 stop PASS "서버 정지·원복"
}

cmd_report() {
  evidence_resume; banner
  rm -f "$TC3_RUN_DIR/report.md" "$TC3_RUN_DIR/summary.json"   # 실패 시 이전 report 가 남아 최신처럼 보이지 않도록
  python3 "$PY/tc3_report.py" "$TC3_RUN_DIR" --backend "$TC3_BACKEND" --describe "$(be_describe)" --model "$TC3_MODEL_NAME" --kit-rev "$KIT_REV" \
    || { fail "report 생성 실패"; return 1; }
  log "report: $TC3_RUN_DIR/report.md"
  local overall; overall="$(json_get '.overall' < "$TC3_RUN_DIR/summary.json" 2>/dev/null)"
  [[ "$overall" == "PASS" || "$overall" == "SIMULATED" ]]
}

cmd_status() {
  evidence_resume
  python3 - "$TC3_RUN_DIR/status.tsv" <<'PYEOF'
import csv, sys, unicodedata
# 한글 등 전각 문자는 터미널에서 2칸 → 표시 폭 기준으로 정렬
wid = lambda s: sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)
rows = [r + [""] * (5 - len(r)) for r in csv.reader(open(sys.argv[1], encoding="utf-8"), delimiter="\t")]
w = [max(wid(r[i]) for r in rows) for i in range(5)]
for r in rows:
    print("  ".join(r[i] + " " * (w[i] - wid(r[i])) for i in range(5)).rstrip())
PYEOF
}

# ---------- ① 사전준비 확인 (preflight) ----------
# 미리 준비해 둔 것(버전·가중치·artifact·포트·디스크·시계…)을 표 한 장으로 보여주고, 같은 내용을
# evidence/<run>/prep_check.log·prep_check.json 에 남긴다 (시험 단계 기록은 하지 않음). 문제(✗)가 있으면 종료코드 1.
# 버전 고정과 다른 설치는 기본 주의(!) — 사전준비는 사용자 책임이므로. TC3_STRICT_VERSIONS=1 이면 문제(✗)로 막는다.
PF_BAD=0; PF_WARN=0; PF_ROWS=()
_pf_clean() { local s="${1//$'\t'/ }"; s="${s//$'\n'/ }"; s="${s//$'\x1f'/ }"; printf '%s' "${s//$'\r'/}"; }
_pf_add() { # _pf_add <ok|bad|warn> <항목> <기대> <실제> [조치]
  case "$1" in bad) PF_BAD=$((PF_BAD + 1)) ;; warn) PF_WARN=$((PF_WARN + 1)) ;; esac
  PF_ROWS+=("$1"$'\x1f'"$(_pf_clean "$2")"$'\x1f'"$(_pf_clean "$3")"$'\x1f'"$(_pf_clean "$4")"$'\x1f'"$(_pf_clean "${5:-}")")
}
_pf_msg() { local r="$1" m="$2"; if [[ "$m" == *": "* ]]; then _pf_add "$r" "${m%%: *}" "" "${m#*: }"; else _pf_add "$r" "$m" "" ""; fi; }
pf_ok()   { _pf_msg ok "$*"; }       # 한 줄 메시지 형식 (백엔드 점검이 사용) — "항목: 내용" 이면 항목/실제로 나눠 표에 넣는다
pf_bad()  { _pf_msg bad "$*"; }
pf_warn() { _pf_msg warn "$*"; }
pf_row()  { _pf_add "$@"; }          # pf_row <ok|bad|warn> <항목> <기대> <실제> [조치]
pf_ver()  { # pf_ver <항목> <기대> <실제> [조치]
  if [[ "$2" == "$3" ]]; then _pf_add ok "$1" "$2" "$3"
  elif [[ "${TC3_STRICT_VERSIONS:-0}" == 1 ]]; then _pf_add bad "$1" "$2" "$3" "${4:-} (TC3_STRICT_VERSIONS=1)"
  else _pf_add warn "$1" "$2" "$3" "${4:-}기대와 다름 — 사전준비한 버전으로 진행 (막으려면 TC3_STRICT_VERSIONS=1)"; fi
}
_weights_desc() { # 가중치 요약: safetensors 개수·크기 (+ index 의 total_size)
  python3 - "$1" <<'PYEOF'
import glob, json, os, sys
d = sys.argv[1]
st = sorted(glob.glob(os.path.join(d, "*.safetensors")))
msg = f"safetensors {len(st)}개 · {sum(os.path.getsize(f) for f in st) / 1e9:.2f} GB"
try:
    ts = json.load(open(os.path.join(d, "model.safetensors.index.json"), encoding="utf-8")).get("metadata", {}).get("total_size")
    msg += f" (index {int(ts) / 1e9:.2f} GB)" if ts else ""
except Exception:
    pass
print(msg)
PYEOF
}
_dir_desc() { local n s; n="$(find "$1" -type f 2>/dev/null | wc -l)"; s="$(du -sb "$1" 2>/dev/null | cut -f1)"; awk -v n="$n" -v s="${s:-0}" 'BEGIN { printf "파일 %d개 · %.2f GB", n, s / 1e9 }'; }
cmd_preflight() {
  use_proxy
  evidence_fresh
  PF_BAD=0; PF_WARN=0; PF_ROWS=()
  # 키트·설정
  local dirty; dirty="$(git -C "$TC3_HOME" status --porcelain --untracked-files=no 2>/dev/null | wc -l)"
  if [[ "$KIT_REV" == "-" ]]; then pf_row warn "키트 커밋" "${TC3_EXPECTED_COMMIT:-git 커밋}" "git 저장소 아님" "커밋 확인 불가"
  elif [[ -n "${TC3_EXPECTED_COMMIT:-}" ]]; then
    local full; full="$(git -C "$TC3_HOME" rev-parse HEAD 2>/dev/null)"
    if [[ "$full" == "$TC3_EXPECTED_COMMIT"* ]]; then pf_row ok "키트 커밋" "${TC3_EXPECTED_COMMIT:0:12}" "$KIT_REV"
    else pf_ver "키트 커밋" "${TC3_EXPECTED_COMMIT:0:12}" "$KIT_REV" "절차서에 적은 커밋과 다름 → git checkout $TC3_EXPECTED_COMMIT. "; fi
  else pf_row ok "키트 커밋" "커밋된 키트" "$KIT_REV"; fi
  (( dirty > 0 )) && pf_row warn "키트 수정" "수정 없음" "커밋 안 된 수정 ${dirty}개" "git status 로 확인"
  [[ -f "$ENV_FILE" ]] && pf_row ok "설정 파일" "tc3.env" "$ENV_FILE" || pf_row warn "설정 파일" "tc3.env" "없음 (기본값 사용)" "cp tc3.env.example tc3.env"
  echo "  설정: backend=$TC3_BACKEND model=$TC3_MODEL_NAME port=$TC3_PORT soak_n=$TC3_SOAK_N ready_timeout=${TC3_READY_TIMEOUT}s fixture=$TC3_FIXTURE"
  [[ -x "$TC3_HOME/bin/tc3" ]] && pf_row ok "실행 권한" "bin/tc3 실행 가능" "있음" || pf_row bad "실행 권한" "bin/tc3 실행 가능" "없음" "chmod +x bin/tc3"
  # 실행 환경
  local pyv; pyv="$(python3 -c 'import platform; print(platform.python_version())' 2>/dev/null)"
  if python3 -c 'import sys; sys.exit(sys.version_info < (3, 8))' 2>/dev/null; then pf_row ok "python3" "≥ 3.8" "$pyv"; else pf_row bad "python3" "≥ 3.8" "${pyv:-없음}"; fi
  local miss; miss="$(for m in requests safetensors numpy; do python3 -c "import $m" 2>/dev/null || printf '%s ' "$m"; done)"
  if [[ -z "$miss" ]]; then pf_row ok "파이썬 패키지" "requests·safetensors·numpy" "모두 있음"; else pf_row bad "파이썬 패키지" "requests·safetensors·numpy" "없음: $miss" "bin/tc3 install (사전준비)"; fi
  if python3 -c 'import matplotlib' 2>/dev/null; then pf_row ok "matplotlib (NPU 그래프)" "있음" "$(python3 -c 'import matplotlib; print(matplotlib.__version__)')"
  else pf_row warn "matplotlib (NPU 그래프)" "있음" "없음" "그래프는 ASCII 로 대체 — 사전준비에서 python3 -m pip install matplotlib"; fi
  have curl && pf_row ok "curl" "있음" "$(curl --version | head -1 | cut -d' ' -f1-2)" || pf_row bad "curl" "있음" "없음"
  have jq || pf_row warn "jq" "있음" "없음" "python 으로 대체 — 동작에는 문제 없음"
  if have tmux; then pf_row ok "tmux (live 화면)" "있음" "$(tmux -V)"; else pf_row warn "tmux (live 화면)" "있음" "없음" "bin/tc3 live 는 run --inline-monitor 로 대체 — 사전준비에서 sudo apt-get install -y tmux"; fi
  # 증빙
  local root; root="$(evidence_root)"
  local free_kb; free_kb="$(df -Pk "$root" 2>/dev/null | awk 'NR == 2 { print $4 }')"
  if [[ -w "$TC3_RUN_DIR" ]]; then
    if [[ -n "$free_kb" ]] && (( free_kb < 1048576 )); then pf_row warn "증빙 디스크" "여유 ≥ 1 GB" "$((free_kb / 1024)) MB"
    else pf_row ok "증빙 디스크" "여유 ≥ 1 GB" "$(awk -v k="${free_kb:-0}" 'BEGIN { printf "%.1f GB", k / 1048576 }')"; fi
  else pf_row bad "증빙 디렉터리" "쓰기 가능" "쓰기 불가: $root"; fi
  pf_row ok "증빙 run" "evidence/<날짜-시각>-$TC3_BACKEND" "evidence/$(basename "$TC3_RUN_DIR")"
  # 모델
  if [[ "$TC3_FIXTURE" == "1" ]]; then pf_row warn "원본 가중치" "실제 가중치" "TC3_FIXTURE=1 (합성 fixture)" "시험 당일은 TC3_FIXTURE=0"
  else
    local wc; if wc="$(check_weights "$TC3_MODEL_DIR" 2>&1)"; then pf_row ok "원본 가중치" "config + safetensors 완전" "$(_weights_desc "$TC3_MODEL_DIR") — $TC3_MODEL_DIR"
    else
      pf_row bad "원본 가중치" "config + safetensors 완전" "원본 가중치 문제: ${wc##*$'\n'} ($TC3_MODEL_DIR)" "사전준비: bin/tc3 fetch-model"
      local hu; hu="$(_hf_whoami)"
      if [[ -n "$hu" ]]; then pf_row ok "HF 로그인" "로그인" "$hu (fetch-model 가능)"; else pf_row warn "HF 로그인" "로그인" "안 됨" "gated 저장소면 bin/tc3 hf-login 후 fetch-model"; fi
    fi
  fi
  # 포트·서버
  if ! be_external_server; then
    if server_alive; then pf_row warn "포트 $TC3_PORT" "비어 있음" "tc3 서버 실행 중 (pid $(server_pid))" "serve 시 자동 재기동, 정리: bin/tc3 stop"
    elif port_in_use "$TC3_PORT"; then pf_row bad "포트 $TC3_PORT" "비어 있음" "다른 프로세스가 사용 중" "포트 $TC3_PORT 사용 프로세스 정리: $(port_owner_cmd "$TC3_PORT")"
    else pf_row ok "포트 $TC3_PORT" "비어 있음" "비어 있음"; fi
  fi
  # 네트워크 (프록시를 쓰는 리허설 환경만)
  if [[ -n "${TC3_PROXY:-}" ]]; then
    local hc; hc="$(curl -s -o /dev/null -m 15 -w '%{http_code}' https://huggingface.co 2>/dev/null)"
    if [[ "$hc" =~ ^(2|3) ]]; then pf_row ok "프록시 경유 외부 접속" "huggingface.co 응답" "정상 ($hc, TC3_PROXY=$TC3_PROXY)"
    elif check_weights "$TC3_MODEL_DIR" >/dev/null 2>&1 && [[ "$TC3_BACKEND" != furiosa || -n "$(ls -A "$TC3_ARTIFACT_DIR" 2>/dev/null)" ]]; then
      pf_row warn "프록시 경유 외부 접속" "huggingface.co 응답" "경유 외부 접속 안 됨 (${hc:-연결 안 됨})" "가중치·artifact 는 이미 있어 시험 단계에는 영향 없음"
    else pf_row bad "프록시 경유 외부 접속" "huggingface.co 응답" "경유 외부 접속 실패 (${hc:-연결 안 됨}, TC3_PROXY=$TC3_PROXY)" "master3 의 tc3-proxy 실행 확인"; fi
  elif [[ -n "${http_proxy:-}${HTTP_PROXY:-}${https_proxy:-}${HTTPS_PROXY:-}" ]]; then
    pf_row ok "프록시 설정" "로컬 API 우회" "감지됨 — 127.0.0.1/localhost 는 no_proxy"
  fi
  # 시계
  local ntp; ntp="$(timedatectl show -p NTPSynchronized --value 2>/dev/null)"
  case "$ntp" in
    yes) pf_row ok "시각·동기화" "$TZ, NTP 동기화" "$(date '+%Y-%m-%d %H:%M:%S %Z') · 동기화됨" ;;
    no)  pf_row warn "시각·동기화" "$TZ, NTP 동기화" "$(date '+%Y-%m-%d %H:%M:%S %Z') · 동기화 안 됨" "증빙 시각이 실제와 다를 수 있음 — timedatectl 확인" ;;
    *)   pf_row ok "시각" "$TZ" "$(date '+%Y-%m-%d %H:%M:%S %Z')" ;;
  esac
  declare -F be_preflight >/dev/null && be_preflight
  # 표 출력 + 증빙 저장
  local colorf=(); [[ -n "$C_RESET" ]] && colorf=(--color)
  printf '%s\n' "${PF_ROWS[@]}" | python3 "$PY/tc3_prep_table.py" "${colorf[@]}" --title "사전준비 확인 — $(be_describe)" \
    --meta "키트 $KIT_REV · 호스트 $(hostname) · 사용자 $(id -un) · $(now_iso)" \
    --log "$TC3_RUN_DIR/prep_check.log" --json "$TC3_RUN_DIR/prep_check.json" \
    --info "time=$(now_iso)" --info "host=$(hostname)" --info "user=$(id -un)" --info "kit=$KIT_REV" --info "backend=$TC3_BACKEND" \
    || warn "사전준비 표 출력 실패 (python3) — 점검 결과: 문제 ${PF_BAD}건, 주의 ${PF_WARN}건"
  echo
  if (( PF_BAD > 0 )); then fail "preflight: 문제 ${PF_BAD}건, 주의 ${PF_WARN}건 — 해결 후 시험 진행 (evidence/$(basename "$TC3_RUN_DIR")/prep_check.log)"; return 1; fi
  ok "preflight: 문제 없음 (주의 ${PF_WARN}건) — evidence/$(basename "$TC3_RUN_DIR")/prep_check.log"
}

cmd_all() {
  evidence_init
  log "run dir: $TC3_RUN_DIR"
  log "backend: $(be_describe)"
  local failed=0
  cmd_env        || failed=1
  cmd_model_size || failed=1
  if cmd_serve; then
    cmd_verify || failed=1
    cmd_soak   || failed=1
  else failed=1; fi
  cmd_stop || failed=1
  cmd_report || failed=1
  echo; cmd_status
  (( failed )) && { fail "일부 단계 실패 — $TC3_RUN_DIR 확인"; return 1; }
  ok "모든 단계 완료 — $TC3_RUN_DIR"
}


# ---------- ② 시험 스크립트 재생 (run / live) ----------
RUN_STEPS=(env model-size serve verify soak stop report)
_step_no()    { case "$1" in env) echo 4 ;; model-size) echo 5 ;; serve) echo 6 ;; verify) echo "7~9" ;; soak) echo 10 ;; stop) echo 11 ;; report) echo 12 ;; *) echo - ;; esac; }
_step_title() { case "$1" in env) echo "가속기·실행환경 확인" ;; model-size) echo "모델 파라미터 수 산출" ;; serve) echo "추론 서버 기동·NPU 적재" ;;
                  verify) echo "모델 목록·한국어/영어 추론" ;; soak) echo "연속 요청 ${TC3_SOAK_N}회" ;; stop) echo "서버 정지·원복" ;; report) echo "판정 보고서" ;; esac; }
_phase() { echo "$1" > "$TC3_RUN_DIR/phase" 2>/dev/null || true; }
# 단계의 최종 결과 (status.tsv 의 해당 절차 번호들 중 가장 나쁜 것) — 화면 끝줄·run_timing.tsv 에 사용
_phase_result() {
  local nums
  case "$1" in env) nums="04" ;; model-size) nums="05" ;; serve) nums="06" ;; verify) nums="07 08 09" ;; soak) nums="10" ;; stop) nums="11" ;;
    report) json_get '.overall' < "$TC3_RUN_DIR/summary.json" 2>/dev/null || echo "-"; return ;; *) echo "-"; return ;; esac
  awk -F'\t' -v n="$nums" 'BEGIN { split(n, a, " "); for (i in a) want[a[i]] = 1 }
    ($1 in want) { seen++; if ($3 == "FAIL") f = 1; else if ($3 == "SIMULATED") s = 1; else if ($3 != "PASS") o = $3 }
    END { if (!seen) print "-"; else if (f) print "FAIL"; else if (s) print "SIMULATED"; else if (o != "") print o; else print "PASS" }' "$TC3_RUN_DIR/status.tsv"
}
_hdr() { # _hdr <k> <n> <단계> <제목> — 캡처 도구는 '━━ [' 로 시작하는 줄을 단계 경계로 본다
  local tag; if [[ "$3" == preflight ]]; then tag="[사전준비]"; else tag="[$1/$2] 절차 $(_step_no "$3") ·"; fi
  echo
  printf '%s━━ %s %s — %s · 시작 %s ━━%s\n' "$C_BOLD" "$tag" "$3" "$4" "$(date +%H:%M:%S)" "$C_RESET"
}

MON_PID=""; MON_BE=""
_monitor_start() {
  [[ "$RUN_MON" == off ]] && { log "NPU 모니터: 끔 (--no-monitor)"; return 0; }
  MON_BE="$(be_monitor_backend)"
  local args=(--backend "$MON_BE" --out "$TC3_RUN_DIR" --interval "${TC3_MONITOR_INTERVAL:-1}")
  [[ "$RUN_MON" == inline ]] && args+=(--inline "${TC3_MONITOR_INLINE:-5}")
  python3 "$PY/tc3_npu_monitor.py" "${args[@]}" 2>> "$TC3_RUN_DIR/npu_monitor.err" &
  MON_PID=$!
  log "NPU 모니터 시작 — ${MON_BE} ${TC3_MONITOR_INTERVAL:-1}s 간격 → npu_samples.csv$( [[ "$MON_BE" == cpu ]] && echo ' (가속기 없음: CPU 로 흉내, SIMULATED)')"
}
_monitor_stop() {
  [[ -n "$MON_PID" ]] || return 0
  if kill -0 "$MON_PID" 2>/dev/null; then
    kill -TERM "$MON_PID" 2>/dev/null
    local i; for i in $(seq 1 50); do kill -0 "$MON_PID" 2>/dev/null || break; sleep 0.1; done
    kill -KILL "$MON_PID" 2>/dev/null || true
  else
    warn "NPU 모니터가 도중에 종료됨 — 시험 판정에는 영향 없음 (npu_monitor.err 확인)"
  fi
  wait "$MON_PID" 2>/dev/null; MON_PID=""
  if [[ -f "$TC3_RUN_DIR/npu_samples.csv" ]] && (( $(wc -l < "$TC3_RUN_DIR/npu_samples.csv") > 1 )); then
    echo
    local simf=(); [[ "$MON_BE" == cpu ]] && simf=(--simulated)
    python3 "$PY/tc3_npu_report.py" "$TC3_RUN_DIR" --backend "$MON_BE" "${simf[@]}" 2>> "$TC3_RUN_DIR/npu_monitor.err" \
      || warn "NPU 요약 생성 실패 — npu_samples.csv 는 남아 있음 (npu_monitor.err)"
  else
    warn "NPU 샘플 없음 — 점유 그래프 생략 (npu_raw.log·npu_monitor.err 확인, 시험 판정과 무관)"
  fi
}
_run_abort() {
  trap - INT TERM
  echo; warn "재생 중단 (Ctrl+C) — 서버를 정리하고 끝냅니다"
  _phase aborted
  rm -f "$TC3_RUN_DIR/.npu_quiet"
  cmd_stop || true
  _monitor_stop
  exit 130
}

cmd_run() {
  local from="${RUN_FROM:-env}" start=-1 i n=${#RUN_STEPS[@]}
  for i in "${!RUN_STEPS[@]}"; do [[ "${RUN_STEPS[$i]}" == "$from" ]] && start=$i; done
  (( start >= 0 )) || die "--from 값은 ${RUN_STEPS[*]} 중 하나 (받은 값: $from)"
  # 처음부터: 아직 시험 기록이 없는 오늘 run(사전준비 확인만 한 run)을 이어 쓰거나 새 run. --from: 현재 run 에서 이어서
  if [[ "$from" == env ]]; then evidence_fresh; else evidence_resume; fi
  local tf="$TC3_RUN_DIR/run_timing.tsv"
  [[ -f "$tf" ]] || printf 'phase\tstep\tstart\tend\tseconds\tresult\n' > "$tf"
  local first_row; first_row=$(( $(wc -l < "$tf") + 1 ))
  banner
  log "시험 스크립트 재생 — $(be_describe) · 연속 요청 ${TC3_SOAK_N}회$( [[ "$from" != env ]] && echo " · $from 부터 이어서")$( [[ -n "$RUN_KEEP" ]] && echo ' · 실패해도 계속')"
  local t_run=$EPOCHREALTIME
  _hdr 0 "$n" preflight "사전준비 확인"
  _phase preflight
  if ! cmd_preflight; then
    fail "사전준비 확인 실패 — 시험 단계를 시작하지 않습니다 (evidence/$(basename "$TC3_RUN_DIR")/prep_check.log)"; return 2
  fi
  unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY all_proxy ALL_PROXY   # 시험 단계에는 프록시를 쓰지 않음
  trap '_run_abort' INT TERM
  [[ "$from" == report ]] || _monitor_start
  local rc=0 failed="" step r res t0 sec s0
  for (( i = start; i < n; i++ )); do
    step="${RUN_STEPS[$i]}"
    if [[ -n "$failed" && -z "$RUN_KEEP" && "$step" != stop && "$step" != report ]]; then
      printf '%s\t%s\t-\t-\t-\tSKIP\n' "$step" "$(_step_no "$step")" >> "$tf"
      warn "[절차 $(_step_no "$step")] $step 건너뜀 — 앞 단계($failed) 실패 (stop·report 는 수행)"
      continue
    fi
    [[ "$step" == report ]] && _monitor_stop   # 점유 측정은 env~stop 구간 — 요약(E)이 report 에 들어가도록 report 전에 정리
    _hdr $((i + 1)) "$n" "$step" "$(_step_title "$step")"
    _phase "$step"; t0=$EPOCHREALTIME; s0="$(now_iso)"
    case "$step" in
      env) cmd_env ;; model-size) cmd_model_size ;; serve) cmd_serve ;; verify) cmd_verify ;;
      soak) cmd_soak ;; stop) cmd_stop ;; report) cmd_report ;;
    esac
    r=$?
    sec="$(awk -v a="$t0" -v b="$EPOCHREALTIME" 'BEGIN { printf "%.1f", b - a }')"
    res="$(_phase_result "$step")"; (( r != 0 )) && [[ "$res" != FAIL ]] && res="FAIL"
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$step" "$(_step_no "$step")" "$s0" "$(now_iso)" "$sec" "$res" >> "$tf"
    if (( r == 0 )); then printf '   %s→ %s (%s s)%s\n' "$C_GREEN" "$res" "$sec" "$C_RESET"
    else printf '   %s→ %s (%s s)%s\n' "$C_RED" "$res" "$sec" "$C_RESET"; rc=1; [[ -z "$failed" ]] && failed="$step"; fi
  done
  _phase done
  trap - INT TERM
  _monitor_stop
  python3 "$PY/tc3_result.py" "$TC3_RUN_DIR" --backend "$TC3_BACKEND" --describe "$(be_describe)" --model "$TC3_MODEL_NAME" --kit-rev "$KIT_REV" --quiet \
    || warn "RESULT.md 생성 실패 — bin/tc3 result 로 다시 생성"
  # 단계별 경과
  local total; total="$(awk -v a="$t_run" -v b="$EPOCHREALTIME" 'BEGIN { s = int(b - a); printf "%d분 %02d초", s / 60, s % 60 }')"
  echo
  log "단계별 경과 (evidence/$(basename "$TC3_RUN_DIR")/run_timing.tsv)"
  tail -n "+$first_row" "$tf" | awk -F'\t' '{ printf "    절차 %-4s  %-11s  %-9s  %8s s\n", $2, $1, $6, $5 }'
  echo "    총 소요 $total"
  echo
  if (( rc )); then fail "재생 결과: 실패 (첫 실패 단계: $failed) — 결과 확인: bin/tc3 result"; return 1; fi
  ok "재생 완료 — 결과 저장·확인: bin/tc3 result"
}

# live: tmux 로 왼쪽 = run 실시간 출력, 오른쪽 = NPU 상태(1초 갱신). 명령은 임시 스크립트로 넘겨 따옴표 문제를 피한다.
cmd_live() {
  local why=""
  have tmux || why="tmux 없음"
  [[ -z "$why" && ! ( -t 0 && -t 1 ) ]] && why="터미널(tty)이 아님"
  [[ -z "$why" && -n "${TMUX:-}" ]] && why="이미 tmux 안에서 실행 중"
  if [[ -n "$why" ]]; then
    warn "live: $why → run --inline-monitor 로 진행 (화면 중간에 NPU 상태 한 줄씩)"
    [[ "$RUN_MON" == off ]] || RUN_MON=inline
    cmd_run; return
  fi
  # 세션 이름 고정: SSH 가 끊겨도 재생은 tmux 안에서 계속된다 → 다시 접속해 bin/tc3 live 를 치면 새로 돌리지 않고 다시 붙는다
  local sess="tc3-live"
  if tmux has-session -t "$sess" 2>/dev/null; then
    warn "live: 이미 재생 중인 화면이 있음 → 새로 시작하지 않고 다시 붙습니다 (tmux attach -t $sess)"
    tmux -u attach-session -t "$sess"; return $?
  fi
  local d; d="$(mktemp -d)"
  {
    echo '#!/usr/bin/env bash'
    local v; while IFS= read -r v; do printf 'export %s=%q\n' "$v" "${!v}"; done < <(compgen -e | grep -E '^(TC3_|HF_|STUB_|PATH$|VIRTUAL_ENV$|LANG$|LC_ALL$|TZ$|PYTHONUNBUFFERED$)')
    echo 'case "${LC_ALL:-${LANG:-}}" in *UTF-8*|*utf8*) ;; *) export LANG=C.UTF-8 ;; esac   # 한글이 _ 로 보이지 않도록'
    printf 'cd %q\n' "$PWD"
    local runcmd=("$TC3_HOME/bin/tc3" run --env "$ENV_FILE" --backend "$TC3_BACKEND")
    [[ -n "$RUN_FROM" ]] && runcmd+=(--from "$RUN_FROM")
    [[ -n "$RUN_KEEP" ]] && runcmd+=(--keep-going)
    [[ "$RUN_MON" == off ]] && runcmd+=(--no-monitor)
    printf '%q ' "${runcmd[@]}"; echo
    printf 'echo $? > %q\n' "$d/rc"
    echo "printf '\\n[tc3] 재생 끝 — Enter 를 누르면 이 화면을 닫습니다 '"
    # Enter 또는 <현재 run>/.live_close 파일(캡처 도구가 마지막 화면을 찍은 뒤 만든다)로 닫는다
    printf 'while :; do if read -r -t 1 _; then break; elif [ $? -le 128 ]; then sleep 1; fi; c="$(cat %q 2>/dev/null)/.live_close"; [ -e "$c" ] && { rm -f "$c"; break; }; done\n' "$(evidence_root)/.current_run"
    printf 'tmux kill-session -t %q\n' "$sess"
  } > "$d/left.sh"
  local panel; panel="$(be_live_panel_cmd)"
  cat > "$d/right.sh" <<EOF
#!/usr/bin/env bash
export PATH=$(printf %q "$PATH")
case "\${LC_ALL:-\${LANG:-}}" in *UTF-8*|*utf8*) ;; *) export LANG=C.UTF-8 ;; esac
while :; do
  if [ -e "\$(cat $(printf %q "$(evidence_root)/.current_run") 2>/dev/null)/.npu_quiet" ]; then
    out="\$(printf 'NPU 상태 %s\n\n추론 서버가 NPU 를 초기화하는 중 — 장치 충돌을 막기 위해 조회를 잠시 멈춤\n(서버 준비가 끝나면 다시 표시)\n' "\$(date +%H:%M:%S)")"
  else
    out="\$( { echo "NPU 상태 \$(date +%H:%M:%S) — 1초마다 갱신"; echo; $panel; } 2>&1 )"
  fi
  printf '\033[H\033[2J%s\n' "\$out"
  sleep 1
done
EOF
  local cols lines; cols="$(tput cols 2>/dev/null || echo 160)"; lines="$(tput lines 2>/dev/null || echo 50)"
  if ! tmux -u new-session -d -s "$sess" -x "$cols" -y "$lines" "bash $d/left.sh"; then
    warn "live: tmux 세션을 만들지 못함 → run --inline-monitor"; rm -rf "$d"; RUN_MON=inline; cmd_run; return
  fi
  tmux set-option -t "$sess" status off >/dev/null
  # 오른쪽 패널: furiosa-smi status 표(63칸)가 줄바꿈 없이 들어가는 66칸 고정 (좁은 창이면 45 %)
  local pw="${TC3_LIVE_PANEL_COLS:-66}"; (( cols - pw < 80 )) && pw="45%"
  tmux split-window -h -l "$pw" -t "$sess" "bash $d/right.sh"
  tmux select-pane -t "$sess:0.0"
  tmux -u attach-session -t "$sess"
  local rc; rc="$(cat "$d/rc" 2>/dev/null)"
  tmux kill-session -t "$sess" 2>/dev/null || true
  rm -rf "$d"
  return "${rc:-1}"
}

# ---------- ③ 결과 저장·확인 ----------
cmd_result() {
  local root; root="$(evidence_root)"
  [[ -n "${TC3_RUN_DIR:-}" ]] || TC3_RUN_DIR="$(cat "$root/.current_run" 2>/dev/null)"
  [[ -n "$TC3_RUN_DIR" && -d "$TC3_RUN_DIR" ]] || die "결과를 만들 run 이 없습니다 — bin/tc3 run 먼저 (또는 --run <evidence/run>)"
  export TC3_RUN_DIR
  local mode=(); [[ -n "$RESULT_FILES" ]] && mode+=(--files); [[ -n "$RESULT_ZIP" ]] && mode+=(--zip)
  python3 "$PY/tc3_result.py" "$TC3_RUN_DIR" --backend "$TC3_BACKEND" --describe "$(be_describe)" --model "$TC3_MODEL_NAME" --kit-rev "$KIT_REV" "${mode[@]}"
}

case "$CMD" in
  install) cmd_install ;;            fetch-model) cmd_fetch_model ;;
  hf-login) cmd_hf_login ;;          hf-logout) cmd_hf_logout ;;
  preflight) cmd_preflight ;;        platform) cmd_platform ;;
  env) cmd_env ;;                    model-size) cmd_model_size ;;
  serve) cmd_serve ;;                verify) cmd_verify ;;
  soak) cmd_soak ;;                  stop) cmd_stop ;;
  report) cmd_report ;;              status) cmd_status ;;
  all) cmd_all ;;
  run) cmd_run ;;                    live) cmd_live ;;
  result) cmd_result ;;
  *) die "알 수 없는 명령: $CMD (bin/tc3 --help)" ;;
esac
